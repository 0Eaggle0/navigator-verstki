---
// Чек-лист «готово» из поля checklist + кнопка «Шаг пройден». Всё запоминается в браузере.
const { entry } = Astro.locals.starlightRoute;
const items = entry.data.checklist;
---

<nav-checklist class="checklist not-content" data-id={entry.id}>
	{
		items.length > 0 && (
			<fieldset>
				<legend class="px-font">Проверь себя перед следующим уровнем</legend>
				{items.map((text, i) => (
					<label>
						<input type="checkbox" value={i} /> {text}
					</label>
				))}
			</fieldset>
		)
	}
	<button type="button" class="checklist__done a-btn--coin a-btn--big" aria-pressed="false">Шаг пройден</button>
	<dialog class="clear" aria-labelledby="clear-title">
		<p id="clear-title" class="clear__title px-font">Уровень пройден!</p>
		<p class="clear__stars" />
		<p class="clear__note" />
		<div class="clear__btns">
			<a class="clear__next a-btn a-btn--go a-btn--big" href="#" hidden>Следующий уровень ▸</a>
			<form method="dialog"><button>Остаться</button></form>
		</div>
	</dialog>
</nav-checklist>

<script>
	import { load, update } from '~/lib/storage';
	import { getLevels, stars, maxStars } from '~/lib/badges';
	import { burst } from '~/lib/fx';

	class Checklist extends HTMLElement {
		connectedCallback() {
			const id = this.dataset.id!;
			const boxes = [...this.querySelectorAll<HTMLInputElement>('input')];
			const btn = this.querySelector<HTMLButtonElement>('.checklist__done')!;
			const p = load();
			const show = (done: boolean) => {
				btn.setAttribute('aria-pressed', String(done));
				btn.textContent = done ? 'Шаг пройден' : 'Отметить шаг пройденным';
			};
			boxes.forEach((b) => (b.checked = (p.checklist[id] ?? []).includes(+b.value)));
			show(p.done.includes(id));

			this.addEventListener('change', () =>
				update((p) => (p.checklist[id] = boxes.filter((b) => b.checked).map((b) => +b.value)))
			);
			btn.addEventListener('click', () => {
				const next = update((p) => {
					p.done = p.done.includes(id) ? p.done.filter((d) => d !== id) : [...p.done, id];
				});
				show(next.done.includes(id));
				if (next.done.includes(id)) celebrate(next);
			});

			// Экран «Уровень пройден»: звёзды по одной и ссылка на следующий шаг
			const dialog = this.querySelector('dialog')!;
			const celebrate = (p: ReturnType<typeof load>) => {
				const level = getLevels()?.find((l) => l.id === id);
				if (!level || !dialog.showModal) return;
				const got = stars(p, level);
				const max = maxStars(level);
				const box = dialog.querySelector('.clear__stars')!;
				box.innerHTML = '';
				for (let i = 0; i < max; i++) {
					const s = document.createElement('span');
					s.textContent = '★';
					s.className = i < got ? 'is-on' : '';
					s.style.animationDelay = `${0.2 + i * 0.25}s`;
					box.append(s);
				}
				box.setAttribute('aria-label', `Звёзд: ${got} из ${max}`);
				dialog.querySelector('.clear__note')!.textContent =
					got === max ? 'Все звёзды собраны!' : 'Звёзды можно добрать: реши разминку и пройди без подсказок.';
				const nextLink = document.querySelector<HTMLAnchorElement>('.pagination-links a[rel="next"]');
				const a = dialog.querySelector<HTMLAnchorElement>('.clear__next')!;
				a.hidden = !nextLink;
				if (nextLink) a.href = nextLink.href;
				dialog.showModal();
				burst(dialog.querySelector('.clear__title')!, true);
			};
		}
	}
	customElements.define('nav-checklist', Checklist);
</script>

<style>
	/* Экран «Уровень пройден» */
	.clear {
		margin: auto;
		max-width: min(26rem, calc(100vw - 2rem));
		padding: 1.5rem;
		text-align: center;
		color: #eceaf7;
		background: #1b1a3f;
		border: 0;
		border-radius: var(--a-r-card);
		box-shadow:
			inset 0 0 0 2px var(--a-coin),
			0 5px 0 var(--a-coin-edge);
		animation: clear-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.clear::backdrop {
		background: #0e0d26b3;
	}
	.clear__title {
		margin: 0;
		font-size: 1.1rem;
		color: var(--px-coin);
		text-shadow: 3px 3px 0 #000;
	}
	.clear__stars {
		display: flex;
		gap: 0.75rem;
		justify-content: center;
		margin: 1.25rem 0 0.75rem;
		font-size: 2.5rem;
		line-height: 1;
	}
	.clear__stars :global(span) {
		color: #3b386c;
		animation: star-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) both;
	}
	.clear__stars :global(.is-on) {
		color: var(--px-coin);
		text-shadow: 3px 3px 0 #7a5600;
	}
	.clear__note {
		margin: 0 0 1.25rem;
		font-size: var(--sl-text-sm);
		color: #c3bfdf;
	}
	.clear__btns {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
		justify-content: center;
	}
	.clear__btns form {
		margin: 0;
	}
	.clear__next[hidden] {
		display: none;
	}
	@keyframes clear-pop {
		from {
			transform: scale(0.5);
		}
	}
	@keyframes star-pop {
		from {
			transform: scale(0);
		}
		60% {
			transform: scale(1.4);
		}
	}
	.checklist {
		display: block;
		margin-block: 2.5rem 1rem;
	}
	.checklist fieldset {
		margin: 0 3px;
		padding: 0.75rem 1rem;
		border: 0;
		background: var(--sl-color-gray-6);
		border-radius: var(--a-r-card);
		box-shadow:
			inset 0 0 0 2px var(--a-line),
			0 5px 0 var(--a-edge);
	}
	.checklist legend {
		float: left;
		width: 100%;
		margin-bottom: 0.6rem;
		font-size: 0.75rem;
		line-height: 1.6;
	}
	.checklist label {
		display: flex;
		clear: left;
		gap: 0.6rem;
		align-items: baseline;
		padding-block: 0.3rem;
		cursor: pointer;
	}
	/* Квадратный пиксельный флажок */
	.checklist input {
		appearance: none;
		flex: none;
		width: 1.1rem;
		height: 1.1rem;
		margin: 0;
		transform: translateY(0.15em);
		background: var(--sl-color-black);
		border: 3px solid var(--px-ink);
		cursor: pointer;
	}
	.checklist input:checked {
		background: var(--px-grass);
		box-shadow: inset 0 0 0 2px var(--sl-color-black);
	}
	.checklist label:has(input:checked) {
		color: var(--sl-color-gray-3);
		text-decoration: line-through;
	}
	.checklist__done {
		margin-top: 1.25rem;
	}
	/* Пройдено — кнопка становится зелёной */
	.checklist__done[aria-pressed='true'] {
		--b: var(--a-go);
		--b-edge: var(--a-go-edge);
	}
</style>
