---
// Заменяет стандартный заголовок Starlight. У страниц-шагов (есть поле minutes) под заголовком —
// игровая панель: «Мир 4-2», звёзды уровня, время шага. На всех страницах кладёт список уровней
// для звёзд и значков и следит за новыми значками.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import Icon from './Icon.astro';
import { LESSONS } from '~/lib/route';

const { entry } = Astro.locals.starlightRoute;
const { lesson, minutes, goal, soon, optional, fast, sidebar } = entry.data;
const isStep = minutes !== undefined;
const maxStars = entry.data.warmup ? 3 : 2;
const splash = entry.data.template === 'splash'; // у главной свой заголовок в HomeHero
---

{!splash && <Default />}
{
	isStep && (
		<div class={`hud w-${lesson} not-content`} data-id={entry.id} data-path={Astro.url.pathname}>
			<span class="hud__level" aria-hidden="true">
				<b>{lesson}-{sidebar.order}</b>
			</span>
			<div class="hud__main">
				<p class="hud__world">
					Урок {lesson} · {LESSONS[lesson!]}
					{optional && <span class="hud__optional">бонусный уровень</span>}
				</p>
				<p class="hud__goal">{goal ?? entry.data.title}</p>
			</div>
			<div class="hud__side">
				<span class="hud__stars" role="img" aria-label={`Звёзды уровня: 0 из ${maxStars}`}>
					{Array.from({ length: maxStars }, () => (
						<svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true">
							<path d="M12 2.5l2.9 6 6.6.8-4.9 4.6 1.3 6.5L12 17.2l-5.9 3.2 1.3-6.5L2.5 9.3l6.6-.8z" />
						</svg>
					))}
				</span>
				<span class="hud__time">
					<Icon name="clock" size={14} />
					{minutes} мин
				</span>
			</div>
			<p class="hud__help">Звёзды: реши разминку, отметь шаг пройденным и пройди без подсказок.</p>
		</div>
	)
}
{
	fast && (
		<p class="step-note step-note--fast" role="note">
			<Icon name="run" size={18} />
			<span>
				<strong>Короткий путь</strong>, если команда отстаёт: {fast}
			</span>
		</p>
	)
}
{
	soon && (
		<p class="step-note" role="note">
			Этот уровень ещё строится. Пока загляни в «Шпаргалки и ссылки» или спроси модератора.
		</p>
	)
}

<script>
	import { load, update } from '~/lib/storage';
	import { checkBadges, getLevels, stars } from '~/lib/badges';

	const hud = document.querySelector<HTMLElement>('.hud');
	if (hud) {
		const id = hud.dataset.id!;
		const level = getLevels()?.find((l) => l.id === id);
		const starsEl = hud.querySelector<HTMLElement>('.hud__stars')!;
		update((p) => (p.last = hud.dataset.path));

		const showStars = () => {
			if (!level) return;
			const n = stars(load(), level);
			[...starsEl.children].forEach((s, i) => s.classList.toggle('is-on', i < n));
			starsEl.setAttribute('aria-label', `Звёзды уровня: ${n} из ${starsEl.children.length}`);
		};

		showStars();
		window.addEventListener('nav-progress', showStars);
	}

	// Значки проверяем при любом изменении прогресса на любой странице
	window.addEventListener('nav-progress', checkBadges);
</script>

<style>
	/* Плашка уровня в цвете мира: номер уровня, мир, цель, звёзды и время */
	.hud {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: 0.5rem 1.25rem;
		align-items: center;
		margin: 1.5rem 0 0;
		padding: 1.1rem 1.25rem;
		background: var(--a-surface);
		border-radius: var(--a-r-card);
		box-shadow:
			inset 0 0 0 2px var(--a-line),
			inset 6px 0 0 var(--w),
			0 6px 0 var(--a-edge);
	}
	.hud__level {
		display: grid;
		place-items: center;
		width: 4.2rem;
		height: 4.2rem;
		color: var(--a-ink);
		background: var(--w);
		border-radius: 50%;
		box-shadow: 0 5px 0 var(--w-edge);
	}
	.hud__level b {
		font: 800 1.15rem var(--a-font);
	}
	.hud__world {
		margin: 0;
		font: 700 0.8rem var(--a-font);
		color: var(--w);
	}
	:global(:root[data-theme='light']) .hud__world {
		color: var(--w-edge);
	}
	.hud__optional {
		margin-inline-start: 0.5rem;
		padding: 0.1rem 0.5rem;
		font-size: 0.7rem;
		color: var(--a-ink);
		background: var(--a-coin);
		border-radius: 999px;
	}
	.hud__goal {
		margin: 0.3rem 0 0;
		font-size: var(--sl-text-xl);
		font-weight: 600;
		line-height: 1.3;
		color: var(--a-text);
	}
	.hud__side {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		align-items: flex-end;
	}
	.hud__stars {
		display: inline-flex;
		gap: 0.15rem;
	}
	.hud__stars svg {
		fill: var(--a-surface-2);
		stroke: var(--a-line);
		stroke-width: 1.5;
		stroke-linejoin: round;
		transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.hud__stars :global(svg.is-on) {
		fill: var(--a-coin);
		stroke: var(--a-coin-edge);
		transform: rotate(-8deg) scale(1.1);
	}
	.hud__time {
		display: inline-flex;
		gap: 0.4rem;
		align-items: center;
		padding: 0.2rem 0.65rem;
		font: 700 0.75rem var(--a-font);
		color: var(--a-muted);
		background: var(--a-surface-2);
		border-radius: 999px;
	}
	.hud__help {
		grid-column: 1 / -1;
		margin: 0.25rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--a-muted);
	}
	@media (max-width: 40rem) {
		.hud {
			grid-template-columns: auto minmax(0, 1fr);
		}
		.hud__level {
			width: 3.4rem;
			height: 3.4rem;
		}
		.hud__side {
			grid-column: 1 / -1;
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
		}
	}
	.step-note {
		display: flex;
		gap: 0.75rem;
		align-items: baseline;
		margin-top: 1.25rem;
		padding: 0.8rem 1.1rem;
		font-size: var(--sl-text-sm);
		background: var(--a-surface);
		border-radius: 16px;
		box-shadow: inset 0 0 0 2px var(--a-line);
	}
	.step-note .px-icon {
		color: var(--a-go);
		transform: translateY(0.15em);
	}
</style>
