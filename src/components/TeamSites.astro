---
// Готовые сайты команд для модератора: превью, код и скачивание папкой (.zip).
// Код сайтов — src/moderator-sites/<кейс>/, точка входа — index.html,
// картинки — public/mod-sites/<кейс>/img/. Страница с этим компонентом лежит внутри <ModSecret>,
// поэтому код попадает на сайт только в зашифрованном виде.
import { Code } from '@astrojs/starlight/components';
import { existsSync, readdirSync } from 'node:fs';

const files = import.meta.glob('/src/moderator-sites/*/*.{html,css,js}', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

// Порядок и подписи сайтов. figma — ссылка на макет команды (если есть)
const SITES = [
	{ id: 'watch', title: 'ЧТО_ПОСМОТРИМ', name: 'Киносфера', note: 'Макет «What to watch». Тёмная тема, две колонки: каталог и комнаты.', figma: 'https://www.figma.com/design/T3EPcU8y2EpvK9NJEo397Z/What-to-watch?node-id=1-2' },
	{ id: 'split', title: 'СКИНЕМСЯ', name: 'Сплит', note: 'Макет команды «пшпшп» (файл «Геймдев»). Светлая тема, баланс, группы, сплит чека.', figma: 'https://www.figma.com/design/sxrufy1CygzJ3myGWPywoL/?node-id=209-214' },
	{ id: 'where', title: 'КУДА_СХОДИТЬ', name: 'Афиша Омска', note: 'Макет «Гейм дизайн» — только для телефона (390 px). Компьютерная версия сделана по его мотивам.', figma: 'https://www.figma.com/design/KrNw2O1NuAChZfjzC59kaU/?node-id=1175-543' },
	{ id: 'teammate', title: 'ТИММЕЙТ', name: 'Проектная школа', note: 'Макет «Проектная школа» пока недоступен: нужен доступ к файлу в Figma. Сайт появится здесь, как только откроют.', figma: 'https://www.figma.com/design/PhxBkGXPbRf1OsJHuZCYCw/' },
	{ id: 'tail', title: 'ХВОСТ_ДОМОЙ', name: 'Заглушка', note: 'Макета у команды нет. Страница собрана из готовых блоков навигатора — пример «быстрого пути».' },
];

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const sites = SITES.map((s) => {
	const prefix = `/src/moderator-sites/${s.id}/`;
	const sources = Object.fromEntries(
		Object.entries(files)
			.filter(([path]) => path.startsWith(prefix))
			.map(([path, source]) => [path.slice(prefix.length), source])
	);
	const dir = `public/mod-sites/${s.id}/img`;
	const images = existsSync(dir)
		? readdirSync(dir, { withFileTypes: true }).filter((entry) => entry.isFile()).map((entry) => entry.name)
		: [];
	return { ...s, sources, images, assets: `${base}mod-sites/${s.id}/img/` };
});
---

<div class="sites not-content">
	{
		sites.map((s) => (
			<section class="site" id={`site-${s.id}`}>
				<div class="site__head">
					<div>
						<p class="site__case">{s.title}</p>
						<h2>{s.name}</h2>
						<p class="site__note">{s.note}</p>
					</div>
					{s.figma && (
						<a class="a-btn" href={s.figma} target="_blank" rel="noopener">
							Макет в Figma
						</a>
					)}
				</div>
				{s.sources['index.html'] ? (
					<nav-site
						data-id={s.id}
						data-sources={JSON.stringify(s.sources)}
						data-assets={s.assets}
						data-images={JSON.stringify(s.images)}
					>
						<div class="site__tools">
							<div class="site__sizes" role="group" aria-label="Ширина превью">
								<button type="button" data-width="100%" aria-pressed="true">Компьютер</button>
								<button type="button" data-width="390px" aria-pressed="false">Телефон</button>
							</div>
							<a class="a-btn a-btn--sky" target="_blank" rel="noopener" data-open>Открыть в новой вкладке</a>
							<button type="button" class="a-btn--go" data-zip>Скачать сайт (.zip)</button>
						</div>
						<div class="site__frame">
							<iframe title={`Готовый сайт: ${s.title}`} loading="lazy" />
						</div>
						<p class="site__status" aria-live="polite" />
						{Object.entries(s.sources).sort(([a], [b]) => a === 'index.html' ? -1 : b === 'index.html' ? 1 : a.localeCompare(b)).map(([name, source]) => (
							<details class="site__code">
								<summary>Код: {name}</summary>
								<Code code={source} lang={name.split('.').at(-1)} />
							</details>
						))}
					</nav-site>
				) : (
					<p class="site__empty">Сайт ещё не свёрстан.</p>
				)}
			</section>
		))
	}
</div>

<script>
	import { zip, type ZipFile } from '~/lib/zip';

	// shortcut: превью открывает index.html и его якоря, для отдельных HTML-страниц нужен загрузчик страниц.
	function preview(sources: Record<string, string>, assets: URL) {
		const doc = new DOMParser().parseFromString(sources['index.html'], 'text/html');
		const imageUrl = (path: string) => new URL(path, assets).href;
		for (const image of doc.querySelectorAll('img[src^="img/"], img[src^="./img/"]')) {
			image.setAttribute('src', imageUrl(image.getAttribute('src')!.replace(/^(?:\.\/)?img\//, '')));
		}
		const urls = new Map<string, string>();
		for (const [name, source] of Object.entries(sources)) {
			if (name.endsWith('.css')) {
				const css = source.replace(/url\(\s*(['"]?)(?:\.\/)?img\/([^)'"]+)\1\s*\)/g,
					(_match, _quote, path) => `url("${imageUrl(path.trim())}")`);
				urls.set(name, URL.createObjectURL(new Blob([css], { type: 'text/css' })));
			} else if (name.endsWith('.js')) {
				urls.set(name, URL.createObjectURL(new Blob([source], { type: 'text/javascript' })));
			}
		}
		for (const tag of doc.querySelectorAll('link[rel="stylesheet"][href], script[src]')) {
			const attr = tag.tagName === 'LINK' ? 'href' : 'src';
			const url = urls.get(tag.getAttribute(attr)!.replace(/^\.\//, ''));
			if (url) tag.setAttribute(attr, url);
		}
		return URL.createObjectURL(new Blob(['<!doctype html>\n', doc.documentElement.outerHTML], { type: 'text/html;charset=utf-8' }));
	}

	class Site extends HTMLElement {
		connectedCallback() {
			const frame = this.querySelector('iframe')!;
			const status = this.querySelector<HTMLElement>('.site__status')!;
			const { id, sources: rawSources, assets: assetPath, images: rawImages } = this.dataset;
			const sources: Record<string, string> = JSON.parse(rawSources!);
			const images: string[] = JSON.parse(rawImages!);
			const assets = new URL(assetPath!, location.href);
			frame.src = preview(sources, assets);
			this.querySelector<HTMLAnchorElement>('[data-open]')!.href = frame.src;

			// Компьютер / телефон — меняем ширину превью
			const sizes = [...this.querySelectorAll<HTMLButtonElement>('[data-width]')];
			sizes.forEach((b) =>
				b.addEventListener('click', () => {
					frame.style.width = b.dataset.width!;
					sizes.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				})
			);

			// Скачать папкой: код + картинки (картинки скачиваем с сайта)
			const download = this.querySelector<HTMLButtonElement>('[data-zip]')!;
			download.addEventListener('click', async () => {
				download.disabled = true;
				status.textContent = 'Собираю архив…';
				try {
					const list: ZipFile[] = Object.entries(sources).map(([name, data]) => ({ name: `${id}/${name}`, data }));
					for (const img of images) {
						const res = await fetch(new URL(encodeURIComponent(img), assets));
						if (!res.ok) throw new Error(`Не удалось загрузить ${img}`);
						list.push({ name: `${id}/img/${img}`, data: new Uint8Array(await res.arrayBuffer()) });
					}
					const a = document.createElement('a');
					const archive = URL.createObjectURL(zip(list));
					a.href = archive;
					a.download = `${id}.zip`;
					a.click();
					setTimeout(() => URL.revokeObjectURL(archive), 60000);
					status.textContent = `Готово: ${id}.zip — распакуй и открой index.html`;
				} catch {
					status.textContent = 'Не получилось собрать архив — проверь интернет и попробуй ещё раз';
				} finally {
					download.disabled = false;
				}
			});
		}
	}
	customElements.define('nav-site', Site);
</script>

<style>
	.sites {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}
	.site {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1.5rem;
		background: var(--a-surface);
		border-radius: var(--a-r-card);
		box-shadow:
			inset 0 0 0 2px var(--a-line),
			0 6px 0 var(--a-edge);
	}
	.site__head {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		align-items: flex-start;
		justify-content: space-between;
	}
	.site__case {
		margin: 0;
		font: 700 0.8rem var(--a-font);
		color: var(--a-coin);
	}
	.site h2 {
		margin: 0.2rem 0 0.4rem;
		font: 800 1.5rem var(--a-font);
		color: var(--a-text);
	}
	.site__note,
	.site__empty {
		margin: 0;
		max-width: 40rem;
		color: var(--a-muted);
	}
	nav-site {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.site__tools {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		align-items: center;
	}
	.site__sizes {
		display: flex;
		gap: 0.25rem;
		padding: 0.25rem;
		margin-right: auto;
		background: var(--a-surface-2);
		border-radius: 999px;
	}
	.site .site__sizes button {
		margin: 0;
		padding: 0.4rem 0.9rem;
		font-size: 0.75rem;
		background: none;
		box-shadow: none;
	}
	.site .site__sizes button[aria-pressed='true'] {
		color: var(--a-ink);
		background: var(--a-coin);
	}
	.site__frame {
		display: flex;
		justify-content: center;
		padding: 0.75rem;
		overflow-x: auto;
		background: var(--a-bg);
		border-radius: 16px;
	}
	.site__frame iframe {
		width: 100%;
		height: 640px;
		background: #fff;
		border: 0;
		border-radius: 10px;
		transition: width 0.3s;
	}
	.site__status {
		min-height: 1.4em;
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--a-go);
	}
	.site__code summary {
		width: fit-content;
		padding: 0.4rem 0.9rem;
		font: 700 0.8rem var(--a-font);
		color: var(--a-text);
		background: var(--a-surface-2);
		border-radius: 999px;
		cursor: pointer;
	}
	.site__code[open] summary {
		margin-bottom: 0.6rem;
	}
	.site__code :global(.expressive-code) {
		max-height: 32rem;
		overflow: auto;
	}
</style>
