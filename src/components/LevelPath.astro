---
// Главная: «Как устроен уровень» — 4 остановки по порядку, у каждой маленькая живая демка.
import { svg } from '~/lib/sprites';
---

<section class="lpath not-content" aria-labelledby="lpath-title">
	<h2 id="lpath-title">Как устроен уровень</h2>
	<ol class="lpath__list">
		<li class="lpath__stop w-6">
			<div class="lpath__demo lpath__demo--byte" aria-hidden="true">
				<span class="lpath__byte" set:html={svg('byte', 44)} />
				<span class="lpath__bubble">display: grid ставит детей в сетку</span>
			</div>
			<h3>Байт рассказывает</h3>
			<p>Теория короткими репликами. Хочешь всё сразу — кнопка «Показать всё».</p>
		</li>
		<li class="lpath__stop w-3">
			<div class="lpath__demo lpath__demo--game" aria-hidden="true">
				<i></i><i></i><i></i>
				<b></b><b></b><b></b>
			</div>
			<h3>Играешь</h3>
			<p>Пишешь одно свойство — фигурки встают на места. 3–5 быстрых уровней.</p>
		</li>
		<li class="lpath__stop w-2">
			<div class="lpath__demo lpath__demo--code" aria-hidden="true">
				<code>.cards &#123;</code>
				<code>&nbsp;&nbsp;display: grid;</code>
				<code>&#125;</code>
				<span class="lpath__check">Всё верно!</span>
			</div>
			<h3>Решаешь разминку</h3>
			<p>Код проверяется сам и подсказывает человеческим языком, что не так.</p>
		</li>
		<li class="lpath__stop w-1">
			<div class="lpath__demo lpath__demo--site" aria-hidden="true">
				<span class="lpath__bar"><i></i><i></i><i></i></span>
				<span class="lpath__head"></span>
				<span class="lpath__cards"><i></i><i></i><i></i></span>
			</div>
			<h3>Делаешь свой сайт</h3>
			<p>То же самое — уже в проекте команды, с подсказками под ваш кейс.</p>
		</li>
	</ol>
</section>

<style>
	.lpath {
		margin-block: 3.5rem 1rem;
	}
	.lpath h2 {
		margin: 0 0 1.5rem;
		font: 800 clamp(1.5rem, 3vw, 2rem) var(--a-font);
		color: var(--a-text);
	}
	.lpath__list {
		position: relative;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: stop;
	}
	/* Пунктирная тропа между остановками */
	.lpath__list::before {
		content: '';
		position: absolute;
		top: 1.1rem;
		left: 6%;
		right: 6%;
		border-top: 4px dashed var(--a-line);
	}
	.lpath__stop {
		position: relative;
		margin: 0;
		padding: 3rem 1.1rem 1.25rem;
		counter-increment: stop;
		background: var(--a-surface);
		border-radius: var(--a-r-card);
		box-shadow:
			inset 0 0 0 2px var(--a-line),
			0 6px 0 var(--a-edge);
	}
	/* Номер остановки — кружок цвета шага на тропе */
	.lpath__stop::before {
		content: counter(stop);
		position: absolute;
		top: -0.3rem;
		left: 1.1rem;
		display: grid;
		place-items: center;
		width: 2.6rem;
		height: 2.6rem;
		font: 800 1.05rem var(--a-font);
		color: var(--a-ink);
		background: var(--w);
		border-radius: 50%;
		box-shadow: 0 4px 0 var(--w-edge);
	}
	.lpath__stop h3 {
		margin: 1rem 0 0.35rem;
		font: 700 1rem var(--a-font);
		color: var(--a-text);
	}
	.lpath__stop p {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--a-muted);
	}
	.lpath__demo {
		position: relative;
		height: 7rem;
		overflow: hidden;
		background: var(--a-surface-2);
		border-radius: 14px;
	}

	/* 1. Байт и облачко, которое печатается */
	.lpath__demo--byte {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		padding: 0.6rem;
	}
	.lpath__byte {
		flex: none;
		animation: lp-bob 1.6s ease-in-out infinite;
	}
	.lpath__bubble {
		padding: 0.45rem 0.6rem;
		font-size: 0.75rem;
		line-height: 1.3;
		color: var(--a-ink);
		background: #fff;
		border-radius: 12px 12px 12px 4px;
		clip-path: inset(0 100% 0 0);
		animation: lp-type 4s steps(24) infinite;
	}

	/* 2. Фигурки едут из столбика в ряд, на призраков */
	.lpath__demo--game i,
	.lpath__demo--game b {
		position: absolute;
		width: 2rem;
		height: 2rem;
		border-radius: 8px;
	}
	.lpath__demo--game b {
		top: 2.5rem;
		border: 2px dashed var(--a-muted);
		opacity: 0.6;
	}
	.lpath__demo--game b:nth-of-type(1) { left: 20%; }
	.lpath__demo--game b:nth-of-type(2) { left: 43%; }
	.lpath__demo--game b:nth-of-type(3) { left: 66%; }
	.lpath__demo--game i {
		left: 0.6rem;
		background: var(--w);
		box-shadow: 0 3px 0 var(--w-edge);
		animation: lp-move 4s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
	}
	.lpath__demo--game i:nth-of-type(1) { top: 0.4rem; --x: calc(20% - 0.6rem); --y: 2.1rem; }
	.lpath__demo--game i:nth-of-type(2) { top: 2.6rem; --x: calc(43% - 0.6rem); --y: -0.1rem; animation-delay: 0.15s; }
	.lpath__demo--game i:nth-of-type(3) { top: 4.8rem; --x: calc(66% - 0.6rem); --y: -2.3rem; animation-delay: 0.3s; }

	/* 3. Код и зелёная плашка «Всё верно!» */
	.lpath__demo--code {
		display: flex;
		flex-direction: column;
		padding: 0.7rem 0.8rem;
		background: #141133;
	}
	.lpath__demo--code code {
		padding: 0;
		font-size: 0.8rem;
		color: #ffe08a;
		background: none;
	}
	.lpath__check {
		position: absolute;
		right: 0.6rem;
		bottom: 0.6rem;
		padding: 0.25rem 0.6rem;
		font: 700 0.7rem var(--a-font);
		color: var(--a-ink);
		background: var(--a-go);
		border-radius: 999px;
		box-shadow: 0 3px 0 var(--a-go-edge);
		animation: lp-pop 4s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
	}

	/* 4. Окно браузера, в котором собирается сайт */
	.lpath__demo--site {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 0.5rem;
		background: #fff;
	}
	.lpath__bar {
		display: flex;
		gap: 0.25rem;
	}
	.lpath__bar i {
		width: 0.45rem;
		height: 0.45rem;
		background: #d6d0fa;
		border-radius: 50%;
	}
	.lpath__head {
		height: 1.2rem;
		background: var(--w);
		border-radius: 6px;
		animation: lp-grow 4s ease-out infinite;
	}
	.lpath__cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.35rem;
		flex: 1;
	}
	.lpath__cards i {
		background: #ece8ff;
		border-radius: 6px;
		animation: lp-pop 4s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
	}
	.lpath__cards i:nth-child(2) { animation-delay: 0.1s; }
	.lpath__cards i:nth-child(3) { animation-delay: 0.2s; }

	@keyframes lp-bob {
		50% { transform: translateY(-4px); }
	}
	@keyframes lp-type {
		0% { clip-path: inset(0 100% 0 0); }
		45%, 90% { clip-path: inset(0 0 0 0); }
		100% { clip-path: inset(0 100% 0 0); }
	}
	@keyframes lp-move {
		0%, 15% { transform: none; }
		45%, 85% { transform: translate(var(--x), var(--y)); }
		100% { transform: none; }
	}
	@keyframes lp-pop {
		0%, 35% { transform: scale(0); }
		50%, 90% { transform: scale(1); }
		100% { transform: scale(0); }
	}
	@keyframes lp-grow {
		0%, 10% { transform: scaleX(0); transform-origin: left; }
		40%, 90% { transform: scaleX(1); transform-origin: left; }
		100% { transform: scaleX(0); transform-origin: left; }
	}
	/* Без анимаций — показываем конечное состояние */
	@media (prefers-reduced-motion: reduce) {
		.lpath__bubble { clip-path: none; }
		.lpath__demo--game i { transform: translate(var(--x), var(--y)); }
	}
	@media (max-width: 60rem) {
		.lpath__list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			row-gap: 2rem;
		}
		.lpath__list::before {
			display: none;
		}
	}
	@media (max-width: 34rem) {
		.lpath__list {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
