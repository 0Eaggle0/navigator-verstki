---
// Закрытая часть раздела модератора. При сборке содержимое шифруется (src/integrations/moderator-lock.mjs),
// на странице — замок и поле для кода доступа. В режиме npm run dev видно сразу (локально).
//   <ModSecret> …материалы модератора… </ModSecret>
---

<mod-secret data-pagefind-ignore><slot /></mod-secret>

<script>
	import { update } from '~/lib/storage';

	const KEY = 'nav-mod-key'; // ключ раздела после удачного ввода кода — чтобы не вводить на каждой странице
	const bytes = (s: string) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
	const store = {
		get: () => {
			try {
				return localStorage.getItem(KEY);
			} catch {
				return null;
			}
		},
		set: (v: string | null) => {
			try {
				v ? localStorage.setItem(KEY, v) : localStorage.removeItem(KEY);
			} catch {
				// без хранилища код придётся вводить на каждой странице
			}
		},
	};

	type Payload = { it: number; keys: { s: string; i: string; c: string; ti?: string; t?: string }[]; i: string; c: string };

	// Код → ключ раздела и имена команды этого кода (если заданы в MODERATOR_CODES).
	// Пробуем каждый сохранённый «замок»: подходит тот, что сделан этим кодом
	async function unwrap(p: Payload, code: string) {
		const base = await crypto.subtle.importKey('raw', new TextEncoder().encode(code.trim()), 'PBKDF2', false, ['deriveKey']);
		for (const k of p.keys) {
			const kek = await crypto.subtle.deriveKey(
				{ name: 'PBKDF2', salt: bytes(k.s), iterations: p.it, hash: 'SHA-256' },
				base,
				{ name: 'AES-GCM', length: 256 },
				false,
				['decrypt']
			);
			try {
				const raw = new Uint8Array(await crypto.subtle.decrypt({ name: 'AES-GCM', iv: bytes(k.i) }, kek, bytes(k.c)));
				const team: string[] = k.t ? JSON.parse(new TextDecoder().decode(await crypto.subtle.decrypt({ name: 'AES-GCM', iv: bytes(k.ti!) }, kek, bytes(k.t)))) : [];
				return { raw, team };
			} catch {
				// не этот код — пробуем следующий
			}
		}
		return null;
	}

	async function open(p: Payload, raw: Uint8Array) {
		const key = await crypto.subtle.importKey('raw', raw, 'AES-GCM', false, ['decrypt']);
		const gz = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: bytes(p.i) }, key, bytes(p.c));
		// Содержимое сжато gzip при сборке (moderator-lock.mjs) — распаковываем
		return new Response(new Blob([gz]).stream().pipeThrough(new DecompressionStream('gzip'))).text();
	}

	class ModSecret extends HTMLElement {
		async connectedCallback() {
			const data = this.dataset.payload;
			if (!data) return; // dev-режим: содержимое и так видно
			const p: Payload = JSON.parse(new TextDecoder().decode(bytes(data)));

			// Уже открывали на этом компьютере — пробуем сохранённый ключ
			const saved = store.get();
			if (saved) {
				try {
					return this.show(await open(p, bytes(saved)));
				} catch {
					store.set(null); // ключ устарел: сайт пересобрали — нужен код заново
				}
			}
			this.lock(p);
		}

		show(html: string) {
			this.innerHTML = html;
			// Скрипты из innerHTML не запускаются — пересоздаём их (кнопки и превью в «Готовых сайтах»)
			for (const old of this.querySelectorAll('script')) {
				const s = document.createElement('script');
				for (const a of old.attributes) s.setAttribute(a.name, a.value);
				s.textContent = old.textContent;
				old.replaceWith(s);
			}
			document.documentElement.dataset.modOpen = '';
		}

		lock(p: Payload) {
			this.innerHTML = `
				<form class="mod-lock not-content">
					<span class="mod-lock__icon" aria-hidden="true">
						<svg viewBox="0 0 24 24"><path d="M7 11V8a5 5 0 0 1 10 0v3M5 11h14v10H5z"/></svg>
					</span>
					<h2>Раздел для модераторов</h2>
					<p>Здесь план занятий, подсказки по проектированию и готовые сайты команд. Код доступа выдаёт организатор.</p>
					<label>Код доступа <input name="code" autocomplete="off" spellcheck="false" required></label>
					<p class="mod-lock__error" role="alert" hidden></p>
					<button type="submit" class="a-btn--go a-btn--big">Открыть</button>
				</form>`;
			const form = this.querySelector('form')!;
			const err = this.querySelector<HTMLElement>('.mod-lock__error')!;
			const btn = form.querySelector('button')!;
			if (!p.keys.length) {
				err.hidden = false;
				err.textContent = 'Коды доступа ещё не настроены. Напиши организатору.';
			}
			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				const code = (form.elements.namedItem('code') as HTMLInputElement).value;
				if (!code.trim()) {
					err.hidden = false;
					err.textContent = 'Введи код доступа.';
					return;
				}
				btn.textContent = 'Проверяю…';
				const found = await unwrap(p, code);
				btn.textContent = 'Открыть';
				if (!found) {
					err.hidden = false;
					err.textContent = 'Код не подходит. Проверь буквы и цифры или попроси новый у организатора.';
					return;
				}
				const { raw, team } = found;
				store.set(btoa(String.fromCharCode(...raw)));
				// Журнал (Attendance.astro) забирает имена команды, а код нужен ему для отправки в таблицу
				try {
					localStorage.setItem('nav-mod-code', code.trim());
					if (team.length) localStorage.setItem('nav-team', JSON.stringify(team));
				} catch {
					// без хранилища имена придётся вписать вручную, а таблица не получит отметки
				}
				// Код подошёл — значит, это модератор: показываем ему ссылки раздела
				update((pr) => {
					if (pr.profile) pr.profile.role = 'moderator';
				});
				document.documentElement.dataset.role = 'moderator';
				this.show(await open(p, raw));
			});
		}
	}
	customElements.define('mod-secret', ModSecret);
</script>

<style>
	mod-secret {
		display: block;
	}
	mod-secret :global(.mod-lock) {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		align-items: flex-start;
		max-width: 30rem;
		margin: 2rem auto;
		padding: 2rem;
		background: var(--a-surface);
		border-radius: 24px;
		box-shadow:
			inset 0 0 0 2px var(--a-line),
			0 6px 0 var(--a-edge);
	}
	mod-secret :global(.mod-lock h2) {
		margin: 0;
		font: 800 1.4rem var(--a-font);
		color: var(--a-text);
	}
	mod-secret :global(.mod-lock p) {
		margin: 0;
		color: var(--a-muted);
	}
	mod-secret :global(.mod-lock__icon) {
		display: grid;
		place-items: center;
		width: 4rem;
		height: 4rem;
		color: var(--a-ink);
		background: var(--a-coin);
		border-radius: 50%;
		box-shadow: 0 5px 0 var(--a-coin-edge);
	}
	mod-secret :global(.mod-lock__icon svg) {
		width: 2rem;
		height: 2rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.4;
		stroke-linejoin: round;
	}
	mod-secret :global(.mod-lock label) {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		width: 100%;
		font: 700 0.85rem var(--a-font);
		color: var(--a-text);
	}
	mod-secret :global(.mod-lock input) {
		padding: 0.7rem 0.9rem;
		font: 600 1.05rem var(--sl-font-mono);
		color: var(--a-text);
		background: var(--a-bg);
		border: 0;
		border-radius: 12px;
		box-shadow: inset 0 0 0 2px var(--a-line);
	}
	mod-secret :global(.mod-lock input:focus-visible) {
		outline: 3px solid var(--a-sky);
	}
	mod-secret :global(.mod-lock__error) {
		color: var(--a-brick) !important;
	}
	mod-secret :global(.mod-lock__error[hidden]) {
		display: none;
	}
</style>
