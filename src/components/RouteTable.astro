---
// Маршрут как карта миров: занятие — мир, шаг — уровень. Уровни — круглые кнопки на
// извилистой тропе. Минуты и шаги — из файлов шагов, звёзды и «ты тут» — из прогресса в браузере.
import { svg } from '~/lib/sprites';
import { getRoute, url, LIMIT_MINUTES, PER_LESSON } from '~/lib/route';

const { lessons, total, warnings } = await getRoute();
const count = lessons.reduce((n, l) => n + l.steps.length, 0);
const MINIMUM = 5; // после этого урока — замок «Минимум»
// Смещение кнопок уровней влево-вправо: тропа петляет
const WAVE = [0, 1, 2, 1, 0, -1, -2, -1];
const STAR = 'M12 2.5l2.9 6 6.6.8-4.9 4.6 1.3 6.5L12 17.2l-5.9 3.2 1.3-6.5L2.5 9.3l6.6-.8z';
---

<div class="map not-content" data-warnings={JSON.stringify(warnings)}>
	<div class="map__score">
		<span class="map__pill">
			<span class="map__star" aria-hidden="true">★</span> Звёзд: <b class="map__stars">0</b> из <b class="map__stars-max">0</b>
		</span>
		<span class="map__pill">Уровней: <b class="map__done">0</b> из {count}</span>
		<span class="map__time">
			{total} мин из {LIMIT_MINUTES} · {lessons.length} пар по {PER_LESSON} минут
		</span>
	</div>

	<ol class="map__worlds">
		{
			lessons.map((l) => (
				<li class={`world w-${l.n}`} data-n={l.n}>
					<div class="world__banner">
						<span class="world__n">{l.n}</span>
						<div>
							<h2 class="world__title">Урок {l.n}. {l.title}</h2>
							<p class="world__result">{l.result}</p>
						</div>
						<span class="world__min">{l.minutes} мин</span>
					</div>
					<ol class="world__levels">
						{l.steps.map((s, i) => (
							<li class="level" data-id={s.id} style={`--shift:${WAVE[i % WAVE.length]}`}>
								<a href={url(s.id + '/')}>
									<span class="level__here" aria-hidden="true">
										<span set:html={svg('byte', 30)} />
										<b>ты тут</b>
									</span>
									<span class="level__block">
										<span class="level__num">{l.n}-{s.data.sidebar.order}</span>
									</span>
									<span class="level__stars" aria-hidden="true">
										{Array.from({ length: s.data.warmup ? 3 : 2 }, () => (
											<svg viewBox="0 0 24 24" width="16" height="16">
												<path d={STAR} />
											</svg>
										))}
									</span>
									<span class="level__title">{s.data.title}</span>
									<span class="level__meta">
										{s.data.minutes} мин{s.data.optional && ', бонус'}
										{s.data.soon && ', строится'}
									</span>
								</a>
							</li>
						))}
					</ol>
					{l.n === MINIMUM && (
						<p class="world__gate">
							<span class="world__gate-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<path d="M4 20V9l3-2 3 2V6l2-2 2 2v3l3-2 3 2v11Zm6 0v-4h4v4" />
								</svg>
							</span>
							<span>
								<b>Замок «Минимум»</b>
								Главная свёрстана и работает на телефоне
							</span>
						</p>
					)}
					{l.n === lessons.length && (
						<p class="world__gate world__gate--finish">
							<span class="world__gate-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<path d="M5 21V4m0 0h11l-2 4 2 4H5" />
								</svg>
							</span>
							<span>
								<b>Финиш</b>
								Сайт открывается по ссылке
							</span>
						</p>
					)}
				</li>
			))
		}
	</ol>
</div>

<script>
	import { load } from '~/lib/storage';
	import { getLevels, stars, maxStars } from '~/lib/badges';

	const map = document.querySelector<HTMLElement>('.map')!;
	JSON.parse(map.dataset.warnings!).forEach((w: string) => console.warn('[маршрут] ' + w));

	const p = load();
	const levels = getLevels() ?? [];
	let got = 0;
	let max = 0;
	let here = false;
	for (const li of map.querySelectorAll<HTMLElement>('.level')) {
		const l = levels.find((x) => x.id === li.dataset.id);
		if (!l) continue;
		const n = stars(p, l);
		got += n;
		max += maxStars(l);
		const done = p.done.includes(l.id);
		li.classList.toggle('is-done', done);
		li.querySelectorAll('.level__stars svg').forEach((s, i) => s.classList.toggle('is-on', i < n));
		li.querySelector('a')!.setAttribute('aria-label', `${li.querySelector('.level__title')!.textContent}: ${done ? 'пройден' : 'не пройден'}, звёзд ${n}`);
		// «Ты тут» — первый непройденный уровень
		if (!done && !here) {
			here = true;
			li.classList.add('is-here');
		}
	}
	map.querySelector('.map__stars')!.textContent = String(got);
	map.querySelector('.map__stars-max')!.textContent = String(max);
	map.querySelector('.map__done')!.textContent = String(p.done.filter((id) => levels.some((l) => l.id === id)).length);
</script>

<style>
	.map__score {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
	}
	.map__pill {
		padding: 0.45rem 1rem;
		font: 700 0.85rem var(--a-font);
		color: var(--a-muted);
		background: var(--a-surface);
		border-radius: 999px;
		box-shadow: inset 0 0 0 2px var(--a-line);
	}
	.map__pill b {
		color: var(--a-text);
	}
	.map__star {
		color: var(--a-coin);
	}
	.map__time {
		font-size: var(--sl-text-sm);
		color: var(--a-muted);
	}

	.map__worlds {
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}
	.world {
		margin: 0 0 3rem;
	}
	/* Баннер мира — полоса его цвета */
	.world__banner {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: 1rem;
		align-items: center;
		padding: 1rem 1.25rem;
		color: var(--a-ink);
		background: var(--w);
		border-radius: var(--a-r-card);
		box-shadow: 0 6px 0 var(--w-edge);
	}
	.world__n {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		font: 800 1.3rem var(--a-font);
		background: #ffffff66;
		border-radius: 50%;
	}
	.world__title {
		margin: 0;
		font: 800 1.15rem/1.2 var(--a-font);
		color: var(--a-ink);
	}
	.world__result {
		margin: 0.2rem 0 0;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		color: var(--a-ink);
	}
	.world__min {
		padding: 0.25rem 0.7rem;
		font: 700 0.75rem var(--a-font);
		background: #ffffff66;
		border-radius: 999px;
	}

	/* Тропа: уровни столбиком, каждый смещён влево-вправо (--shift) */
	.world__levels {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.75rem;
		margin: 0;
		padding: 2.75rem 0 0.5rem;
		list-style: none;
	}
	.level {
		margin: 0 !important;
		transform: translateX(calc(var(--shift) * 4.5rem));
	}
	.level a {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 15rem);
		gap: 0.1rem 1rem;
		align-items: center;
		text-decoration: none;
		color: var(--a-text);
	}
	/* Кнопка уровня: круг с объёмным краем */
	.level__block {
		grid-row: span 3;
		display: grid;
		place-items: center;
		width: 4.5rem;
		height: 4.5rem;
		color: var(--a-muted);
		background: var(--a-surface-2);
		border-radius: 50%;
		box-shadow:
			inset 0 0 0 3px var(--a-line),
			0 6px 0 var(--a-edge);
		transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.level__num {
		font: 800 0.95rem var(--a-font);
	}
	.level a:hover .level__block,
	.level a:focus-visible .level__block {
		transform: translateY(-4px) scale(1.05);
	}
	.level a:active .level__block {
		transform: translateY(6px);
		box-shadow: inset 0 0 0 3px var(--a-line);
	}
	.level.is-done .level__block {
		color: var(--a-ink);
		background: var(--w);
		box-shadow: 0 6px 0 var(--w-edge);
	}
	.level.is-here .level__block {
		color: var(--a-ink);
		background: var(--a-coin);
		box-shadow: 0 6px 0 var(--a-coin-edge);
		animation: lvl-pulse 1.6s ease-in-out infinite;
	}
	@keyframes lvl-pulse {
		50% {
			box-shadow:
				0 6px 0 var(--a-coin-edge),
				0 0 0 10px #ffc93033;
		}
	}
	.level__stars {
		display: flex;
		gap: 2px;
	}
	.level__stars svg {
		fill: var(--a-surface-2);
		stroke: var(--a-line);
		stroke-width: 2;
	}
	.level__stars :global(svg.is-on) {
		fill: var(--a-coin);
		stroke: var(--a-coin-edge);
	}
	.level__title {
		font-size: var(--sl-text-sm);
		font-weight: 600;
		line-height: 1.3;
	}
	.level a:hover .level__title {
		text-decoration: underline;
	}
	.level__meta {
		font-size: var(--sl-text-xs);
		color: var(--a-muted);
	}
	/* «Ты тут»: Байт над текущим уровнем */
	.level__here {
		position: absolute;
		left: 0.6rem;
		top: -2.5rem;
		display: none;
		align-items: center;
		gap: 0.3rem;
		font: 800 0.7rem var(--a-font);
		color: var(--a-coin);
		white-space: nowrap;
	}
	:global(:root[data-theme='light']) .level__here {
		color: var(--a-coin-edge);
	}
	.level__here span {
		line-height: 0;
	}
	.level.is-here .level__here {
		display: inline-flex;
		animation: bob 1.2s ease-in-out infinite;
	}
	@keyframes bob {
		50% {
			transform: translateY(-4px);
		}
	}

	/* Замок и финиш — большие отметки на тропе */
	.world__gate {
		display: flex;
		gap: 1rem;
		align-items: center;
		width: fit-content;
		margin: 2rem auto 0;
		padding: 0.9rem 1.25rem;
		color: var(--a-muted);
		background: var(--a-surface);
		border-radius: var(--a-r-card);
		box-shadow:
			inset 0 0 0 2px var(--a-line),
			0 6px 0 var(--a-edge);
	}
	.world__gate b {
		display: block;
		font: 800 1rem var(--a-font);
		color: var(--a-text);
	}
	.world__gate-icon {
		display: grid;
		flex: none;
		place-items: center;
		width: 3.2rem;
		height: 3.2rem;
		color: var(--a-ink);
		background: var(--a-pink);
		border-radius: 50%;
		box-shadow: 0 4px 0 var(--a-pink-edge);
	}
	.world__gate--finish .world__gate-icon {
		background: var(--a-go);
		box-shadow: 0 4px 0 var(--a-go-edge);
	}
	.world__gate-icon svg {
		width: 1.6rem;
		height: 1.6rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	@media (max-width: 40rem) {
		.level {
			transform: translateX(calc(var(--shift) * 1.25rem));
		}
		.level a {
			grid-template-columns: auto minmax(0, 11rem);
		}
		.world__banner {
			grid-template-columns: auto minmax(0, 1fr);
		}
		.world__min {
			grid-column: 2;
			justify-self: start;
		}
	}
</style>
