---
// Кнопка «Частые ошибки»: частые ошибки по шагу из поля mistakes
import Icon from './Icon.astro';
const { mistakes } = Astro.locals.starlightRoute.entry.data;
---

<details class="stuck not-content">
	<summary class="px-font"><Icon name="question" size={20} /> Частые ошибки</summary>
	<div class="stuck__body">
		{
			mistakes.length > 0 && (
				<dl>
						{mistakes.map((m) => (
							<>
								<dt>{m.q}</dt>
								<dd>{m.a}</dd>
							</>
						))}
				</dl>
			)
		}
		<p>
			Не помогло? Сравни свой код с подсказками выше, проверь консоль браузера (F12 → Console) и позови модератора
			— это нормально.
		</p>
	</div>
</details>

<style>
	.stuck {
		margin: 1.5rem 3px 1rem;
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
		border-radius: var(--a-r-card);
		box-shadow:
			inset 0 0 0 2px var(--a-brick),
			0 5px 0 var(--a-brick-edge);
	}
	.stuck summary {
		display: flex;
		gap: 0.6rem;
		align-items: center;
		padding: 0.6rem 1rem;
		font-size: 0.75rem;
		line-height: 1.5;
		cursor: pointer;
		list-style: none;
	}
	.stuck summary::-webkit-details-marker {
		display: none;
	}
	.stuck summary :global(.px-icon) {
		color: var(--px-brick);
	}
	.stuck__body {
		padding: 0 1rem 0.75rem;
	}
	.stuck dt {
		font-weight: 600;
		margin-top: 0.5rem;
	}
	.stuck dd {
		margin: 0 0 0 1rem;
	}
</style>
