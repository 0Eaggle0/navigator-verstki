---
// Для модератора: план каждого занятия по минутам и частые ошибки.
// Всё собирается из файлов шагов — отдельно ничего поддерживать не нужно.
import { getRoute, url } from '~/lib/route';

const { lessons } = await getRoute();

// 0 → «0:00», 95 → «1:35»
const time = (m: number) => `${Math.floor(m / 60)}:${String(m % 60).padStart(2, '0')}`;
---

<div class="mplan not-content">
	{
		lessons.map((l) => {
			let start = 0;
			return (
				<details class="mplan__lesson">
					<summary>
						Занятие {l.n} · {l.title} <span>{l.minutes} мин</span>
					</summary>
					<p class="mplan__result">Результат занятия: {l.result}</p>
					<table>
						<thead>
							<tr>
								<th scope="col">Время</th>
								<th scope="col">Шаг</th>
								<th scope="col">Мин</th>
							</tr>
						</thead>
						<tbody>
							{l.steps.map((s) => {
								const from = start;
								start += s.data.minutes ?? 0;
								return (
									<tr>
										<td>
											{time(from)}–{time(start)}
										</td>
										<td>
											<a href={url(s.id + '/')}>{s.data.title}</a>
											{s.data.optional && <em> · можно пропустить</em>}
											{s.data.soon && <em> · шаг пишется</em>}
											{s.data.fast && <div class="mplan__fast">Быстрый путь: {s.data.fast}</div>}
										</td>
										<td>{s.data.minutes}</td>
									</tr>
								);
							})}
						</tbody>
					</table>
					{l.steps.some((s) => s.data.mistakes.length) && (
						<>
							<p class="mplan__sub">Частые ошибки занятия</p>
							<dl>
								{l.steps.flatMap((s) =>
									s.data.mistakes.map((m) => (
										<>
											<dt>
												{m.q} <span>({s.data.title})</span>
											</dt>
											<dd>{m.a}</dd>
										</>
									))
								)}
							</dl>
						</>
					)}
				</details>
			);
		})
	}
</div>

<style>
	.mplan__lesson {
		margin-block: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0;
	}
	.mplan__lesson summary {
		padding: 0.75rem 1rem;
		font-weight: 600;
		cursor: pointer;
	}
	.mplan__lesson summary span,
	.mplan dt span {
		font-weight: 400;
		color: var(--sl-color-gray-3);
	}
	.mplan__lesson > :not(summary) {
		margin-inline: 1rem;
	}
	.mplan__result,
	.mplan__sub {
		margin-block: 0.5rem;
		font-weight: 600;
	}
	.mplan table {
		width: calc(100% - 2rem);
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
	}
	.mplan th,
	.mplan td {
		padding: 0.4rem 0.5rem;
		text-align: left;
		vertical-align: top;
		border-bottom: 1px solid var(--sl-color-gray-5);
	}
	.mplan td:first-child {
		white-space: nowrap;
	}
	.mplan__fast {
		margin-top: 0.25rem;
		color: var(--sl-color-gray-3);
	}
	.mplan dl {
		margin-bottom: 1rem;
		font-size: var(--sl-text-sm);
	}
	.mplan dt {
		margin-top: 0.5rem;
		font-weight: 600;
	}
	.mplan dd {
		margin: 0 0 0 1rem;
	}
</style>
