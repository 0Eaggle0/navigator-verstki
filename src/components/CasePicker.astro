---
// Главная: выбор кейса команды («выбор персонажа»), мини-карта миров и кнопка «Начать / Продолжить»
import cases from '~/data/cases.json';
import Icon from './Icon.astro';
import { getRoute, getLevels, url } from '~/lib/route';

const { steps, lessons } = await getRoute();
const levels = await getLevels();
const first = url(steps[0].id + '/');
// Для «Продолжить»: шаги по порядку, чтобы найти первый непройденный
const order = steps.map((s) => [s.id, url(s.id + '/'), s.data.soon]);
---

<script id="nav-levels" type="application/json" set:html={JSON.stringify(levels)} />
<nav-case-picker class="picker not-content" data-order={JSON.stringify(order)}>
	<fieldset>
		<legend class="px-font">Выберите кейс команды</legend>
		<div class="picker__grid">
			{
				cases.map((c) => (
					<label class="picker__card">
						<input type="radio" name="case" value={c.id} />
						<span class="picker__chosen px-font">
							<Icon name="arrow" size={12} /> ваш кейс
						</span>
						<strong class="px-font">{c.title}</strong>
						<span>{c.about}</span>
					</label>
				))
			}
		</div>
	</fieldset>

	<ol class="picker__worlds" aria-label="Прогресс по мирам">
		{
			lessons.map((l) => (
				<li data-ids={JSON.stringify(l.steps.map((s) => s.id))}>
					<span class="picker__world px-font">{l.n}</span>
					<span class="picker__world-name">{l.title}</span>
					<span class="picker__world-count">0 из {l.steps.length}</span>
				</li>
			))
		}
	</ol>

	<a class="picker__go px-font" href={first}>Начать игру с уровня 1-1</a>
</nav-case-picker>

<script>
	import { load, update } from '~/lib/storage';
	import { checkBadges } from '~/lib/badges';

	class CasePicker extends HTMLElement {
		connectedCallback() {
			const p = load();
			const go = this.querySelector<HTMLAnchorElement>('.picker__go')!;
			const order: [string, string, boolean][] = JSON.parse(this.dataset.order!);
			const done = order.filter(([id]) => p.done.includes(id)).length; // старые id (после переименований) не считаем

			// Мини-карта: сколько уровней пройдено в каждом мире
			for (const li of this.querySelectorAll<HTMLElement>('.picker__worlds li')) {
				const ids: string[] = JSON.parse(li.dataset.ids!);
				const n = ids.filter((id) => p.done.includes(id)).length;
				li.querySelector('.picker__world-count')!.textContent = `${n} из ${ids.length}`;
				li.classList.toggle('is-done', n === ids.length);
				li.classList.toggle('is-started', n > 0 && n < ids.length);
			}

			// «Продолжить» ведёт к первому непройденному шагу (из уже написанных)
			const next = order.find(([id, , soon]) => !soon && !p.done.includes(id));
			if (done || p.last) {
				go.href = next ? next[1] : p.last ?? go.href;
				go.textContent = next ? 'Продолжить игру' : 'Все уровни пройдены! Открыть последний';
			}
			const radio = this.querySelector<HTMLInputElement>(`input[value="${p.case}"]`);
			if (radio) radio.checked = true;
			this.addEventListener('change', (e) => update((p) => (p.case = (e.target as HTMLInputElement).value)));
			window.addEventListener('nav-progress', checkBadges);
		}
	}
	customElements.define('nav-case-picker', CasePicker);
</script>

<style>
	.picker fieldset {
		border: 0;
		padding: 0;
		margin: 0;
	}
	.picker legend {
		margin-bottom: 1.25rem;
		font-size: 1.05rem;
		line-height: 1.5;
		color: var(--sl-color-white);
	}
	.picker__grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
		gap: 1.25rem;
	}
	/* Карточка персонажа: пиксельная рамка, выбранная — золотая с меткой «ваш кейс» */
	.picker__card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		margin: 3px;
		padding: 1rem;
		background: var(--sl-color-gray-6);
		box-shadow:
			0 -3px 0 0 var(--px-ink),
			0 3px 0 0 var(--px-ink),
			-3px 0 0 0 var(--px-ink),
			3px 0 0 0 var(--px-ink);
		cursor: pointer;
	}
	.picker__card:hover {
		transform: translateY(-3px);
	}
	.picker__card:has(input:checked) {
		background: var(--sl-color-accent-low);
		box-shadow:
			0 -4px 0 0 var(--px-coin),
			0 4px 0 0 var(--px-coin),
			-4px 0 0 0 var(--px-coin),
			4px 0 0 0 var(--px-coin);
	}
	.picker__card:has(input:focus-visible) {
		outline: 3px solid var(--px-coin);
		outline-offset: 6px;
	}
	.picker__card input {
		position: absolute;
		opacity: 0;
	}
	.picker__card strong {
		font-size: 0.75rem;
		line-height: 1.5;
		font-weight: 400;
		color: var(--sl-color-white);
		overflow-wrap: anywhere;
	}
	.picker__card > span:last-child {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.picker__chosen {
		display: none;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.55rem;
		color: var(--sl-color-accent);
	}
	.picker__card:has(input:checked) .picker__chosen {
		display: inline-flex;
	}

	/* Мини-карта миров */
	.picker__worlds {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 9rem), 1fr));
		gap: 0.75rem;
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}
	.picker__worlds li {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0 0.6rem;
		align-items: center;
		margin: 0;
	}
	.picker__world {
		grid-row: span 2;
		display: grid;
		place-items: center;
		width: 2.4rem;
		height: 2.4rem;
		margin: 3px;
		font-size: 0.75rem;
		color: #fff;
		background: #8a4d2c;
		box-shadow:
			0 -3px 0 0 var(--px-ink),
			0 3px 0 0 var(--px-ink),
			-3px 0 0 0 var(--px-ink),
			3px 0 0 0 var(--px-ink),
			inset -4px -4px 0 0 #0003;
	}
	.picker__worlds .is-started .picker__world {
		color: #1e1b3a;
		background: var(--px-coin);
	}
	.picker__worlds .is-done .picker__world {
		background: var(--px-grass);
	}
	.picker__world-name {
		font-size: var(--sl-text-sm);
		font-weight: 600;
		line-height: 1.2;
		color: var(--sl-color-white);
	}
	.picker__world-count {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	/* Главная кнопка — большая «нажимаемая» */
	.picker__go {
		display: inline-block;
		margin: 2rem 4px 0;
		padding: 0.9rem 1.4rem;
		font-size: 0.85rem;
		line-height: 1.5;
		text-decoration: none;
		color: #1e1b3a;
		background: var(--px-coin);
		box-shadow:
			0 -4px 0 0 var(--px-ink),
			0 4px 0 0 var(--px-ink),
			-4px 0 0 0 var(--px-ink),
			4px 0 0 0 var(--px-ink),
			inset 0 -6px 0 0 #0003;
	}
	.picker__go:hover {
		color: #1e1b3a;
		transform: translateY(-2px);
	}
	.picker__go:active {
		transform: translateY(2px);
	}
</style>
