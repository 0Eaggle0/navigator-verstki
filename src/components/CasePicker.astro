---
// Главная: выбор кейса команды — «выбор персонажа». У каждого кейса свой цвет
// и нарисованная на CSS мини-превью будущего сайта. Выбор хранится в браузере.
import cases from '~/data/cases.json';

// Цвет карточки кейса — из цветов миров (custom.css, .w-N)
const COLOR: Record<string, number> = { watch: 3, teammate: 6, where: 5, tail: 4, split: 1 };
---

<nav-case-picker class="picker not-content">
	<fieldset>
		<legend>
			<span class="picker__title">Выбери кейс команды</span>
			<span class="picker__sub">Подсказки в шагах подстроятся под ваш сайт</span>
		</legend>
		<div class="picker__grid">
			{
				cases.map((c) => (
					<label class={`picker__card w-${COLOR[c.id] ?? 2}`} data-case={c.id}>
						<input type="radio" name="case" value={c.id} />
						<span class={`picker__art picker__art--${c.id}`} aria-hidden="true">
							{c.id === 'watch' && (
								<>
									<i /><i /><i /><i />
								</>
							)}
							{c.id === 'teammate' && (
								<>
									<i><b /><em /></i>
									<i><b /><em /></i>
								</>
							)}
							{c.id === 'where' && (
								<>
									<b /><b /><b />
									<i /><i /><i />
								</>
							)}
							{c.id === 'tail' && (
								<>
									<i /><i /><i />
								</>
							)}
							{c.id === 'split' && (
								<>
									<i><b /></i>
									<em /><em /><em />
								</>
							)}
						</span>
						<span class="picker__chosen">твой кейс</span>
						<strong>{c.title.replace('_', '_​') /* перенос строки после «_» */}</strong>
						<span class="picker__about">{c.about}</span>
					</label>
				))
			}
		</div>
	</fieldset>
</nav-case-picker>

<script>
	import { load, update } from '~/lib/storage';
	import { checkBadges } from '~/lib/badges';
	import { burst } from '~/lib/fx';

	class CasePicker extends HTMLElement {
		connectedCallback() {
			const radio = this.querySelector<HTMLInputElement>(`input[value="${load().case}"]`);
			if (radio) radio.checked = true;
			this.addEventListener('change', (e) => {
				const input = e.target as HTMLInputElement;
				update((p) => (p.case = input.value));
				burst(input.closest('label')!);
			});
			window.addEventListener('nav-progress', checkBadges);

			// Карточка слегка наклоняется за мышкой
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			for (const card of this.querySelectorAll<HTMLElement>('.picker__card')) {
				card.addEventListener('pointermove', (e) => {
					const r = card.getBoundingClientRect();
					const x = (e.clientX - r.left) / r.width - 0.5;
					const y = (e.clientY - r.top) / r.height - 0.5;
					card.style.transform = `translateY(-6px) rotateX(${(-y * 8).toFixed(1)}deg) rotateY(${(x * 10).toFixed(1)}deg)`;
				});
				card.addEventListener('pointerleave', () => (card.style.transform = ''));
			}
		}
	}
	customElements.define('nav-case-picker', CasePicker);
</script>

<style>
	.picker {
		display: block;
		margin-block: 3.5rem 1rem;
	}
	.picker fieldset {
		margin: 0;
		padding: 0;
		border: 0;
	}
	.picker legend {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		margin-bottom: 1.5rem;
		padding: 0;
	}
	.picker__title {
		font: 800 clamp(1.5rem, 3vw, 2rem) var(--a-font);
		color: var(--a-text);
	}
	.picker__sub {
		color: var(--a-muted);
	}
	.picker__grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 12.5rem), 1fr));
		gap: 1.25rem;
		perspective: 900px;
	}
	/* Карточка персонажа */
	.picker__card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 0.75rem 0.75rem 1.1rem;
		background: var(--a-surface);
		border-radius: 22px;
		box-shadow:
			inset 0 0 0 2px var(--a-line),
			0 6px 0 var(--a-edge);
		cursor: pointer;
		transform-style: preserve-3d;
		transition:
			transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
			box-shadow 0.2s;
	}
	.picker__card:hover {
		transform: translateY(-6px);
	}
	.picker__card:has(input:checked) {
		box-shadow:
			inset 0 0 0 4px var(--w),
			0 6px 0 var(--w-edge);
	}
	.picker__card:has(input:focus-visible) {
		outline: 3px solid var(--a-sky);
		outline-offset: 4px;
	}
	.picker__card input {
		position: absolute;
		opacity: 0;
	}
	.picker__card strong {
		margin: 0.6rem 0.35rem 0;
		font: 800 0.95rem/1.2 var(--a-font);
		color: var(--a-text);
		overflow-wrap: anywhere;
	}
	.picker__about {
		margin: 0 0.35rem;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--a-muted);
	}
	.picker__chosen {
		position: absolute;
		top: 1.1rem;
		right: 1.1rem;
		z-index: 1;
		display: none;
		padding: 0.2rem 0.6rem 0.2rem 0.45rem;
		font: 800 0.7rem var(--a-font);
		color: var(--a-ink);
		background: #fff;
		border-radius: 999px;
		box-shadow: 0 3px 0 #0004;
	}
	.picker__chosen::before {
		content: '✓ ';
		color: var(--w-edge);
	}
	.picker__card:has(input:checked) .picker__chosen {
		display: block;
		animation: pick-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	@keyframes pick-pop {
		from {
			transform: scale(0);
		}
	}

	/* Мини-превью сайта кейса: фон цвета кейса и нарисованные блоки */
	.picker__art {
		position: relative;
		display: grid;
		gap: 0.4rem;
		height: 7.5rem;
		padding: 0.75rem;
		background: var(--w);
		border-radius: 16px;
		box-shadow: inset 0 -5px 0 var(--w-edge);
		overflow: hidden;
	}
	.picker__art i,
	.picker__art b,
	.picker__art em {
		display: block;
		border-radius: 8px;
		transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	/* ЧТО_ПОСМОТРИМ — постеры фильмов, один «свайпается» */
	.picker__art--watch {
		grid-template-columns: repeat(4, 1fr);
		align-items: end;
	}
	.picker__art--watch i {
		height: 78%;
		background: #fff;
		box-shadow: inset 0 -1.2rem 0 #1d174822;
	}
	.picker__art--watch i:nth-child(2) {
		height: 92%;
		background: #1d1748;
		transform: rotate(-6deg);
	}
	.picker__card:hover .picker__art--watch i:nth-child(2) {
		transform: rotate(-16deg) translateX(-8px);
	}
	/* ТИММЕЙТ — анкеты с аватаром и «навыками» */
	.picker__art--teammate {
		grid-template-columns: 1fr 1fr;
	}
	.picker__art--teammate i {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		align-items: center;
		justify-content: center;
		background: #fff;
	}
	.picker__art--teammate b {
		width: 2rem;
		height: 2rem;
		background: #1d1748;
		border-radius: 50%;
	}
	.picker__art--teammate em {
		width: 75%;
		height: 0.5rem;
		background: repeating-linear-gradient(90deg, #a77bff 0 30%, transparent 30% 36%);
		border-radius: 4px;
	}
	.picker__card:hover .picker__art--teammate i:first-child {
		transform: rotate(-4deg) translateY(-3px);
	}
	/* КУДА_СХОДИТЬ — фильтры-пилюли и карточки событий */
	.picker__art--where {
		grid-template-columns: repeat(3, 1fr);
		grid-template-rows: 0.9rem 1fr;
	}
	.picker__art--where b {
		border-radius: 999px;
		background: #fff;
	}
	.picker__art--where b:first-child {
		background: #1d1748;
	}
	.picker__art--where i {
		background: #fff;
		box-shadow: inset 0 1.6rem 0 #1d174822;
	}
	.picker__card:hover .picker__art--where i:nth-of-type(2) {
		transform: translateY(-4px);
	}
	/* ХВОСТ_ДОМОЙ — карточки питомцев с «мордочками» */
	.picker__art--tail {
		grid-template-columns: repeat(3, 1fr);
	}
	.picker__art--tail i {
		position: relative;
		background: #fff;
	}
	.picker__art--tail i::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 28%;
		width: 1.5rem;
		height: 1.3rem;
		margin-left: -0.75rem;
		background: #f5a14a;
		border-radius: 45% 45% 50% 50%;
	}
	.picker__art--tail i:nth-child(2)::before {
		background: #c08552;
	}
	.picker__art--tail i:nth-child(3)::before {
		background: #888;
	}
	.picker__art--tail i::after {
		content: '';
		position: absolute;
		left: 18%;
		right: 18%;
		bottom: 16%;
		height: 0.5rem;
		background: #ff8a3d;
		border-radius: 4px;
	}
	.picker__card:hover .picker__art--tail i:nth-child(2) {
		transform: translateY(-5px) rotate(3deg);
	}
	/* СКИНЕМСЯ — сбор с прогрессом и строки «кто сколько должен» */
	.picker__art--split {
		grid-template-rows: 1.1rem repeat(3, 0.55rem);
		align-content: center;
	}
	.picker__art--split i {
		background: #ffffff66;
		border-radius: 999px;
		overflow: hidden;
	}
	.picker__art--split i b {
		width: 62%;
		height: 100%;
		background: #fff;
		border-radius: 999px;
		transition: width 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.picker__card:hover .picker__art--split i b {
		width: 94%;
	}
	.picker__art--split em {
		background: #fff;
		border-radius: 4px;
	}
	.picker__art--split em:nth-of-type(2) {
		width: 70%;
	}
	.picker__art--split em:nth-of-type(3) {
		width: 45%;
	}
</style>
