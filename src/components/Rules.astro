---
// Главная: правила игры — 4 карточки: мир, уровень, звёзды, прогресс.
const RULES = [
	{ w: 1, t: 'Урок = одна пара', d: '80 минут на урок. Уроки 1–5 дают «Минимум»: главная свёрстана и работает на телефоне. 6 и 7 — JavaScript и публикация.' },
	{ w: 2, t: 'Уровень = шаг', d: 'Цель, Байт с теорией, мини-игра, разминка и задание для вашего сайта.' },
	{ w: 4, t: 'Три звезды', d: 'За решённую разминку, за пройденный шаг и за прохождение без подсказок. Застрял — открывай подсказку, звезда не главное.' },
	{ w: 6, t: 'Прогресс в браузере', d: 'Звёзды и значки хранятся на этом компьютере. На другом начнёшь с нуля — шаги можно просто отметить.' },
];
---

<section class="rules not-content" aria-labelledby="rules-title">
	<h2 id="rules-title">Правила игры</h2>
	<ul>
		{
			RULES.map((r) => (
				<li class={`w-${r.w}`}>
					<strong>{r.t}</strong>
					<p>{r.d}</p>
				</li>
			))
		}
	</ul>
</section>

<style>
	.rules {
		margin-block: 3.5rem 1rem;
	}
	.rules h2 {
		margin: 0 0 1.5rem;
		font: 800 clamp(1.5rem, 3vw, 2rem) var(--a-font);
		color: var(--a-text);
	}
	.rules ul {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.rules li {
		margin: 0;
		padding: 1.1rem 1.2rem 1.25rem;
		background: var(--a-surface);
		border-radius: var(--a-r-card);
		box-shadow:
			inset 0 0 0 2px var(--a-line),
			inset 0 6px 0 var(--w),
			0 6px 0 var(--a-edge);
	}
	.rules strong {
		display: block;
		margin-top: 0.35rem;
		font: 800 1rem var(--a-font);
		color: var(--a-text);
	}
	.rules p {
		margin: 0.4rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--a-muted);
	}
</style>
