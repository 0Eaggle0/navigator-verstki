---
// Карта миров на главной: воксельный 3D-остров (src/lib/island.ts) с подписями-ссылками.
// Без WebGL остров не грузится, а подписи остаются обычным рядом кнопок-миров.
import { getRoute, url } from '~/lib/route';

const { lessons } = await getRoute();
const worlds = lessons.map((l) => ({
	n: l.n,
	title: l.title,
	ids: l.steps.map((s) => s.id),
	urls: l.steps.map((s) => url(s.id + '/')),
}));
---

<nav-island class="island not-content" data-worlds={JSON.stringify(worlds)}>
	<canvas aria-hidden="true"></canvas>
	<ol class="island__worlds" aria-label="Миры">
		{
			worlds.map((w) => (
				<li>
					<a class={`island__label w-${w.n}`} href={w.urls[0]}>
						<b>{w.n}</b>
						<span>{w.title}</span>
					</a>
				</li>
			))
		}
	</ol>
	<p class="island__help">Покрути остров и выбери мир</p>
</nav-island>

<script>
	import { load } from '~/lib/storage';

	class Island extends HTMLElement {
		connectedCallback() {
			const worlds: { n: number; ids: string[]; urls: string[] }[] = JSON.parse(this.dataset.worlds!);
			const labels = [...this.querySelectorAll<HTMLAnchorElement>('.island__label')];
			const p = load();
			// «Ты тут» — мир первого непройденного шага; ссылка мира ведёт на этот шаг
			const here = worlds.findIndex((w) => w.ids.some((id) => !p.done.includes(id)));
			const state = worlds.map((w, i) => {
				const next = w.ids.findIndex((id) => !p.done.includes(id));
				if (next > 0) labels[i].href = w.urls[next];
				const done = next === -1;
				labels[i].classList.toggle('is-done', done);
				labels[i].classList.toggle('is-here', i === here);
				return { n: w.n, done, here: i === here };
			});

			const gl = (() => {
				try {
					return !!document.createElement('canvas').getContext('webgl2');
				} catch {
					return false;
				}
			})();
			// Без WebGL — компактный список миров вместо пустого неба
			if (!gl) return void this.classList.add('is-flat');
			const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
			import('~/lib/island')
				.then((m) => m.init(this, state, labels, calm))
				.catch((e) => {
					console.warn('Остров не загрузился, показываем список миров', e);
					this.classList.add('is-flat');
				});
		}
	}
	customElements.define('nav-island', Island);
</script>

<style>
	/* Небо за островом: ночью звёзды, днём голубое. Высота задаётся снаружи (--island-h) */
	.island {
		position: relative;
		display: block;
		height: 100%;
		min-height: var(--island-h, 26rem);
		overflow: hidden;
		background:
			radial-gradient(ellipse at 50% 65%, #5a4bb8 0%, transparent 60%),
			#241d5c;
		border-radius: 28px;
		box-shadow:
			inset 0 0 0 2px var(--a-line),
			0 8px 0 var(--a-edge);
	}
	:global(:root[data-theme='light']) .island {
		background:
			radial-gradient(ellipse at 50% 70%, #ffffff 0%, transparent 60%),
			#a9dcff;
	}
	.island::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image:
			radial-gradient(circle, #fff 1.2px, transparent 1.5px), radial-gradient(circle, #fff9 1px, transparent 1.3px);
		background-size:
			90px 70px,
			53px 61px;
		background-position:
			0 0,
			27px 31px;
		opacity: 0.55;
	}
	:global(:root[data-theme='light']) .island::before {
		display: none;
	}
	.island.is-flat {
		min-height: 0;
		height: auto;
	}
	.island canvas {
		display: none;
	}
	.island.is-3d canvas {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		cursor: grab;
		touch-action: pan-y;
	}
	/* Без 3D — ряд кнопок-миров */
	.island__worlds {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 0;
		padding: 1.5rem;
		list-style: none;
	}
	.island__worlds li {
		margin: 0;
	}
	/* Подпись мира — объёмная пилюля его цвета */
	.island__label {
		display: inline-flex;
		gap: 0.45rem;
		align-items: center;
		padding: 0.3rem 0.75rem 0.3rem 0.3rem;
		font: 700 0.8rem var(--a-font);
		white-space: nowrap;
		text-decoration: none;
		color: var(--a-ink);
		background: #fff;
		border-radius: 999px;
		box-shadow: 0 4px 0 #0005;
		transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.island__label b {
		display: grid;
		place-items: center;
		width: 1.6rem;
		height: 1.6rem;
		font-weight: 800;
		color: var(--a-ink);
		background: var(--w);
		border-radius: 50%;
		box-shadow: inset 0 -3px 0 var(--w-edge);
	}
	.island__label.is-done b::after {
		content: '✓';
	}
	.island__label.is-done b {
		font-size: 0;
	}
	.island__label.is-done b::after {
		font-size: 0.85rem;
	}
	.island__label.is-here {
		outline: 3px solid var(--a-coin);
		outline-offset: 2px;
	}
	.island__label:hover,
	.island__label:focus-visible,
	.island__label:global(.is-hover) {
		color: var(--a-ink);
		transform: translate(-50%, -100%) scale(1.08);
	}
	.island:not(.is-3d) .island__label:hover {
		transform: scale(1.05);
	}
	/* В 3D подписи висят над мирами; название видно при наведении */
	.island.is-3d .island__worlds {
		position: absolute;
		inset: 0;
		padding: 0;
		pointer-events: none;
	}
	.island.is-3d .island__label {
		position: absolute;
		transform: translate(-50%, -100%);
		pointer-events: auto;
	}
	.island.is-3d .island__label {
		padding-inline-end: 0.3rem;
	}
	.island.is-3d .island__label span {
		display: none;
	}
	.island.is-3d .island__label:hover,
	.island.is-3d .island__label:focus-visible,
	.island.is-3d .island__label:global(.is-hover) {
		padding-inline-end: 0.75rem;
		z-index: 200 !important;
	}
	.island.is-3d .island__label:hover span,
	.island.is-3d .island__label:focus-visible span,
	.island.is-3d .island__label:global(.is-hover) span {
		display: inline;
	}
	.island__help {
		display: none;
	}
	.island.is-3d .island__help {
		position: absolute;
		right: 1rem;
		bottom: 0.75rem;
		display: block;
		margin: 0;
		padding: 0.25rem 0.7rem;
		font-size: var(--sl-text-xs);
		color: #fff;
		background: #0004;
		border-radius: 999px;
	}
</style>
