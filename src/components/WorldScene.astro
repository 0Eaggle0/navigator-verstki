---
// Пиксельный пейзаж мира над заголовком шага. Рисуется при сборке, картинок нет.
// Три слоя (дальний, средний, ближний) сдвигаются с разной скоростью — параллакс.
// <WorldScene n={4} />
import { svg, type SpriteName } from '~/lib/sprites';

interface Props {
	n: number;
	label?: string;
	small?: boolean; // низкая полоса — для карты миров
}
const { n, label, small } = Astro.props;

// Биом мира: цвета слоёв, высота холмов и что растёт на переднем плане
const BIOMES: Record<number, { far: string; mid: string; near: string; hills: number; decor: SpriteName[]; extra?: SpriteName }> = {
	1: { far: '#7fb5e8', mid: '#6cc76c', near: '#3f9b3f', hills: 18, decor: ['flower', 'tree', 'flower', 'rock'] },
	2: { far: '#4f8f7a', mid: '#2f6b4f', near: '#1e4a33', hills: 26, decor: ['pine', 'pine', 'tree', 'pine'] },
	3: { far: '#8fb8e0', mid: '#5aa64a', near: '#3b8fd9', hills: 14, decor: ['lily', 'lily', 'rock'] },
	4: { far: '#9fd08a', mid: '#70b85a', near: '#7a5230', hills: 10, decor: ['fence', 'flower', 'fence', 'tree'] },
	5: { far: '#c8d4ee', mid: '#7f86b8', near: '#55517f', hills: 44, decor: ['rock', 'pine', 'rock'] },
	6: { far: '#6a5f9e', mid: '#433b78', near: '#2b2750', hills: 20, decor: ['tower', 'rock', 'tower'] },
	7: { far: '#3b386c', mid: '#29275a', near: '#1b1a3f', hills: 12, decor: ['star', 'planet', 'star'], extra: 'planet' },
};
const b = BIOMES[n] ?? BIOMES[1];

// Детерминированный «случай»: одинаковая картинка при каждой сборке
let seed = n * 9301 + 49297;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);

// Ступенчатый холм шириной 320 «пикселей», высотой до amp, по шагам в 8 пикселей
const W = 320;
const H = 72;
const ridge = (amp: number, base: number, color: string) => {
	let d = `M0 ${H}`;
	for (let x = 0; x < W; x += 8) {
		const y = Math.round(H - base - (Math.sin((x / W) * Math.PI * 2 + n) * 0.5 + 0.5) * amp - rnd() * 6);
		d += ` V${y} H${x + 8}`;
	}
	return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" shape-rendering="crispEdges"><path d="${d} V${H} Z" fill="${color}"/></svg>`;
};
const far = ridge(b.hills, 22, b.far);
const mid = ridge(b.hills * 0.6, 12, b.mid);
const decor = Array.from({ length: 9 }, (_, i) => ({ name: b.decor[i % b.decor.length], x: 4 + i * 11 + rnd() * 5 }));
---

<div class:list={['scene', `scene--${n}`, 'not-content', { 'scene--small': small }]} aria-hidden="true">
	<div class="scene__sky">
		<span class="scene__cloud" style="left:12%;top:18%" />
		<span class="scene__cloud" style="left:58%;top:30%;animation-delay:-14s" />
		{b.extra && <span class="scene__extra" set:html={svg(b.extra, 40)} />}
	</div>
	<div class="scene__layer scene__far" data-depth="0.2" set:html={far} />
	<div class="scene__layer scene__mid" data-depth="0.5" set:html={mid} />
	<div class="scene__layer scene__near" data-depth="1" style={`--near:${b.near}`}>
		{decor.map((d) => <span class="scene__decor" style={`left:${d.x}%`} set:html={svg(d.name, 28)} />)}
	</div>
	{label && <span class="scene__label px-font">{label}</span>}
</div>

<script>
	// Параллакс: слои сдвигаются от прокрутки и движения мыши
	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		for (const scene of document.querySelectorAll<HTMLElement>('.scene')) {
			const layers = [...scene.querySelectorAll<HTMLElement>('[data-depth]')];
			let mx = 0;
			const move = () =>
				layers.forEach((l) => (l.style.transform = `translateX(${Math.round((mx * 24 - scrollY * 0.08) * +l.dataset.depth!)}px)`));
			addEventListener('scroll', move, { passive: true });
			scene.addEventListener('pointermove', (e) => {
				const r = scene.getBoundingClientRect();
				mx = (e.clientX - r.left) / r.width - 0.5;
				move();
			});
		}
	}
</script>

<style>
	.scene {
		position: relative;
		height: 150px;
		margin: 0 0 1.25rem;
		overflow: hidden;
		image-rendering: pixelated;
		box-shadow:
			0 -3px 0 0 var(--px-ink),
			0 3px 0 0 var(--px-ink),
			-3px 0 0 0 var(--px-ink),
			3px 0 0 0 var(--px-ink);
		margin-inline: 3px;
	}
	/* Небо: днём голубое, ночью тёмное со звёздами */
	.scene__sky {
		position: absolute;
		inset: 0;
		background: linear-gradient(#2a2860, #4b3f86 70%, #7a5c9e);
	}
	.scene__sky::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(#fff 0 0), linear-gradient(#fff 0 0), linear-gradient(#fffa 0 0), linear-gradient(#fff 0 0),
			linear-gradient(#fffa 0 0), linear-gradient(#fff 0 0);
		background-size: 3px 3px;
		background-repeat: no-repeat;
		background-position: 8% 20%, 23% 45%, 41% 12%, 67% 30%, 79% 10%, 92% 38%;
		animation: twinkle 3s steps(2) infinite;
	}
	:global(:root[data-theme='light']) .scene__sky {
		background: linear-gradient(#5fb4ff, #a8dbff 70%, #e6f6ff);
	}
	:global(:root[data-theme='light']) .scene__sky::before {
		display: none;
	}
	/* Ночью луна, днём солнце */
	.scene__sky::after {
		content: '';
		position: absolute;
		top: 18px;
		right: 22%;
		width: 24px;
		height: 24px;
		background: #fff6c8;
		box-shadow:
			0 -4px 0 -0px #fff6c8,
			0 4px 0 0 #fff6c8,
			-4px 0 0 0 #fff6c8,
			4px 0 0 0 #fff6c8,
			0 0 0 10px #fff6c822;
	}
	:global(:root[data-theme='light']) .scene__sky::after {
		background: #ffd84a;
		box-shadow:
			0 -4px 0 0 #ffd84a,
			0 4px 0 0 #ffd84a,
			-4px 0 0 0 #ffd84a,
			4px 0 0 0 #ffd84a,
			0 0 0 12px #ffd84a44;
	}
	.scene--7 .scene__sky::after {
		display: none;
	}
	.scene--7 .scene__sky,
	:global(:root[data-theme='light']) .scene--7 .scene__sky {
		background: linear-gradient(#0e0d26, #2a2860);
	}
	.scene--7 .scene__sky::before,
	:global(:root[data-theme='light']) .scene--7 .scene__sky::before {
		display: block;
	}
	/* Облако из пиксельных прямоугольников */
	.scene__cloud {
		position: absolute;
		width: 48px;
		height: 12px;
		background: #ffffffcc;
		box-shadow:
			12px -9px 0 -0px #ffffffcc,
			24px -9px 0 0 #ffffffcc;
		animation: drift 40s linear infinite;
	}
	:global(:root:not([data-theme='light'])) .scene__cloud {
		background: #ffffff33;
		box-shadow:
			12px -9px 0 0 #ffffff33,
			24px -9px 0 0 #ffffff33;
	}
	.scene__extra {
		position: absolute;
		top: 14px;
		right: 12%;
	}
	.scene__layer {
		position: absolute;
		left: -80px;
		right: -80px;
		bottom: 0;
		transition: transform 0.2s steps(4);
	}
	.scene__layer :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}
	.scene__far {
		height: 100%;
	}
	.scene__mid {
		height: 70%;
	}
	.scene__near {
		height: 26px;
		background: var(--near);
		box-shadow: inset 0 4px 0 0 #0003;
	}
	.scene__decor {
		position: absolute;
		bottom: 18px;
		line-height: 0;
	}
	:global(:root:not([data-theme='light'])) .scene__layer {
		filter: brightness(0.8) saturate(0.9);
	}
	.scene__label {
		position: absolute;
		left: 12px;
		top: 12px;
		padding: 0.35rem 0.6rem;
		font-size: 0.6rem;
		color: #fff;
		background: #0e0d26cc;
	}
	@keyframes drift {
		to {
			transform: translateX(60vw);
		}
	}
	@keyframes twinkle {
		50% {
			opacity: 0.5;
		}
	}
	.scene--small {
		height: 96px;
		margin: 0 0 1rem;
		box-shadow: none;
	}
	@media (max-width: 40rem) {
		.scene {
			height: 110px;
		}
		.scene--small {
			height: 80px;
		}
	}
</style>
