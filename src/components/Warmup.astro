---
// Песочница-разминка. Задача, стартовый код и автопроверки берутся из поля warmup во frontmatter.
// Черновик сохраняется в браузере, «Сбросить» возвращает стартовый код.
const { entry } = Astro.locals.starlightRoute;
const w = entry.data.warmup;
const hasJs = w?.js !== undefined; // есть поле js — разминка на JavaScript
---

{
	w && (
		<nav-sandbox class="sandbox not-content" data-id={entry.id} data-html={w.html} data-css={w.css} data-checks={JSON.stringify(w.checks)} data-js={hasJs ? w.js : undefined}>
			<p class="sandbox__task">
				<strong>Задача:</strong> {w.task}
			</p>
			<div class="sandbox__grid">
				<div class="sandbox__editors">
					<label>
						HTML
						<textarea name="html" spellcheck="false" autocapitalize="off" wrap="off" rows="10" />
					</label>
					<label>
						CSS
						<textarea name="css" spellcheck="false" autocapitalize="off" wrap="off" rows="8" />
					</label>
					{hasJs && (
						<label>
							JavaScript
							<textarea name="js" spellcheck="false" autocapitalize="off" wrap="off" rows="10" />
						</label>
					)}
					<p class="sandbox__tip">Tab — отступ. Чтобы уйти из поля клавиатурой: Esc, потом Tab.</p>
				</div>
				<div class="sandbox__result">
					{w.width && <p class="sandbox__width">Превью шириной {w.width} px — как на телефоне</p>}
					<div class="sandbox__frame">
						<iframe
							title="Результат разминки"
							sandbox={hasJs ? undefined : 'allow-same-origin'}
							style={w.width ? `width:${w.width}px` : undefined}
						/>
						<div class="sandbox__clear px-font" role="status" hidden>
							<span class="sandbox__coin" aria-hidden="true" />
							<b>Разминка пройдена!</b>
							<span>+1 звезда</span>
						</div>
						{/* Для JS-разминок проверки идут в скрытой копии: они нажимают кнопки и не должны менять то, что видит ученик */}
						{hasJs && (
							<iframe
								class="sandbox__checker"
								title="Проверка"
								aria-hidden="true"
								tabindex="-1"
								style={w.width ? `width:${w.width}px` : undefined}
							/>
						)}
					</div>
					{hasJs && (
						<div class="sandbox__console" aria-live="polite">
							<p class="sandbox__console-title">Консоль</p>
							<ol />
						</div>
					)}
					<div class="sandbox__checks" aria-live="polite" />
					<button type="button" class="sandbox__reset">Сбросить к началу</button>
				</div>
			</div>
		</nav-sandbox>
	)
}

<script>
	import { load, update } from '~/lib/storage';
	import { runChecks, unclosedTag, type Check } from '~/lib/checks';
	import { srcdoc } from '~/lib/srcdoc';

	// Частые ошибки JavaScript — переводим на понятный язык
	const explain = (text: string) =>
		text
			.replace(/^(Uncaught )?SyntaxError: /, 'синтаксическая ошибка — проверь скобки и кавычки. ')
			.replace(/^(Uncaught )?\w*Error: /, '')
			.replace(/Cannot (read|set) propert(y|ies) of null.*/, 'querySelector ничего не нашёл (получился null) — проверь селектор и что элемент есть в HTML')
			.replace(/Cannot (read|set) propert(y|ies) of undefined.*/, 'обращение к тому, чего нет (undefined) — проверь имя переменной или свойства')
			.replace(/(\S+) is not defined/, 'имя «$1» не найдено — опечатка или переменная не объявлена')
			.replace(/(\S+) is not a function/, '«$1» — не функция: проверь название метода и скобки');

	class Sandbox extends HTMLElement {
		connectedCallback() {
			const { id = '', html = '', css = '', js } = this.dataset;
			const hasJs = js !== undefined;
			const checks: Check[] = JSON.parse(this.dataset.checks || '[]');
			const fields = [...this.querySelectorAll('textarea')];
			const [htmlBox, cssBox, jsBox] = fields;
			const frame = this.querySelector<HTMLIFrameElement>('iframe:not(.sandbox__checker)')!;
			// Где запускаем проверки: для JS — в скрытой копии, иначе прямо в превью
			const checker = this.querySelector<HTMLIFrameElement>('.sandbox__checker') ?? frame;
			const out = this.querySelector<HTMLElement>('.sandbox__checks')!;
			const logList = this.querySelector('.sandbox__console ol');
			const clear = this.querySelector<HTMLElement>('.sandbox__clear')!;

			const draft = load().drafts[id];
			htmlBox.value = draft?.html ?? html;
			cssBox.value = draft?.css ?? css;
			if (jsBox) jsBox.value = draft?.js ?? js ?? '';

			// Консоль: сообщения приходят из превью через postMessage
			window.addEventListener('message', (e) => {
				if (!logList || e.source !== frame.contentWindow || !e.data?.sandbox) return;
				const { kind, text, line } = e.data;
				const li = document.createElement('li');
				li.className = 'is-' + kind;
				li.textContent = kind === 'error' ? `Ошибка${line > 0 ? ` в строке ${line}` : ''}: ${explain(text)}` : text;
				logList.append(li);
			});

			checker.addEventListener('load', () => {
				if (!checks.length || !checker.contentDocument) return;
				const results = runChecks(checker.contentDocument, checks);
				// Незакрытый тег — первой строкой: из-за него остальные проверки врут
				const open = unclosedTag(htmlBox.value);
				if (open) results.unshift({ ok: false, message: `Похоже, не закрыт тег <${open}> — найди, где он должен закончиться, и поставь </${open}>` });
				const failed = results.filter((r) => !r.ok);
				// classList, а не className: иначе стирается класс, по которому Astro применяет стили
				out.classList.toggle('is-wip', failed.length > 0);
				out.classList.toggle('is-ok', failed.length === 0);
				out.innerHTML = '';
				const head = document.createElement('p');
				head.textContent = failed.length
					? `Проверка: ${results.length - failed.length} из ${results.length}. Осталось:`
					: 'Всё верно! Разминка пройдена.';
				out.append(head);
				if (failed.length) {
					const ul = document.createElement('ul');
					for (const f of failed) ul.append(Object.assign(document.createElement('li'), { textContent: f.message }));
					out.append(ul);
				}
				// Первое решение: записываем и показываем «Разминка пройдена»
				if (!failed.length && !load().solved.includes(id)) {
					update((p) => p.solved.push(id));
					clear.hidden = false;
					setTimeout(() => (clear.hidden = true), 2600);
				}
			});

			const render = () => {
				if (logList) logList.innerHTML = '';
				const doc = srcdoc(htmlBox.value, cssBox.value, hasJs ? jsBox.value : undefined);
				frame.srcdoc = doc;
				if (checker !== frame) checker.srcdoc = doc;
			};
			let timer: number;
			const onInput = () => {
				clearTimeout(timer);
				timer = window.setTimeout(
					() => {
						render();
						update((p) => (p.drafts[id] = { html: htmlBox.value, css: cssBox.value, js: jsBox?.value }));
					},
					hasJs ? 800 : 400 // JS ждём дольше: недописанный код почти всегда с ошибкой
				);
			};

			let escaped = false; // после Esc Tab снова переводит фокус, а не вставляет отступ
			for (const box of fields) {
				box.addEventListener('input', onInput);
				box.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') return void (escaped = true);
					if (e.key !== 'Tab' || escaped) return void (escaped = false);
					e.preventDefault();
					box.setRangeText('  ', box.selectionStart, box.selectionEnd, 'end');
					onInput();
				});
			}

			this.querySelector('.sandbox__reset')!.addEventListener('click', () => {
				htmlBox.value = html;
				cssBox.value = css;
				if (jsBox) jsBox.value = js ?? '';
				update((p) => delete p.drafts[id]);
				render();
			});

			render();
		}
	}
	customElements.define('nav-sandbox', Sandbox);
</script>

<style>
	/* Песочница — «игровой экран» в пиксельной рамке */
	.sandbox {
		display: block;
		margin: 2rem 3px 1.5rem;
		padding: 1rem;
		background: var(--sl-color-gray-6);
		box-shadow:
			0 -3px 0 0 var(--px-ink),
			0 3px 0 0 var(--px-ink),
			-3px 0 0 0 var(--px-ink),
			3px 0 0 0 var(--px-ink);
	}
	.sandbox__task {
		margin: 0 0 1rem;
	}
	.sandbox__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
		gap: 1rem;
	}
	.sandbox label {
		display: block;
		font: 400 0.7rem var(--px-font);
		margin-bottom: 0.75rem;
	}
	/* Редактор всегда тёмный, как экран консоли */
	.sandbox textarea {
		display: block;
		width: 100%;
		margin-top: 0.25rem;
		padding: 0.5rem;
		font: 0.875rem/1.5 var(--__sl-font-mono, ui-monospace, Consolas, monospace);
		tab-size: 2;
		resize: vertical;
		color: #e8e6f5;
		background: #141333;
		border: 2px solid var(--px-ink);
		border-radius: 0;
		caret-color: var(--px-coin);
	}
	.sandbox__tip {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.sandbox__grid > * {
		min-width: 0; /* иначе превью 375 px растягивает колонку шире экрана */
	}
	.sandbox__width {
		margin: 0 0 0.25rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.sandbox__frame {
		position: relative;
		overflow-x: auto; /* узкое превью на телефоне прокручивается внутри, а не всей страницей */
	}
	.sandbox iframe {
		display: block;
		width: 100%;
		height: 16rem;
		border: 2px solid var(--px-ink);
		background: #fff;
		resize: vertical;
	}
	.sandbox__checker {
		position: absolute;
		top: 0;
		left: 0;
		visibility: hidden;
		height: 16rem;
		pointer-events: none;
	}
	/* «Разминка пройдена!» — появляется один раз, когда разминка решена впервые */
	.sandbox__clear {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		align-items: center;
		justify-content: center;
		text-align: center;
		color: #fff;
		background: #1b1a3ff5;
		animation: clear-in 0.3s steps(3) both;
	}
	.sandbox__clear[hidden] {
		display: none;
	}
	.sandbox__clear b {
		font-size: 1.05rem;
		font-weight: 400;
		color: var(--px-coin);
		text-shadow: 3px 3px 0 #000;
	}
	.sandbox__coin {
		width: 24px;
		height: 32px;
		background: var(--px-coin);
		box-shadow:
			inset -6px 0 0 #c98f00,
			0 -3px 0 0 #7a5600,
			0 3px 0 0 #7a5600,
			-3px 0 0 0 #7a5600,
			3px 0 0 0 #7a5600;
		animation: coin-jump 0.6s steps(6) 2;
	}
	@keyframes clear-in {
		from {
			opacity: 0;
		}
	}
	@keyframes coin-jump {
		50% {
			transform: translateY(-18px);
		}
	}
	.sandbox__console {
		margin-top: 0.75rem;
		padding: 0.5rem 0.75rem;
		font: 0.8125rem/1.4 var(--__sl-font-mono, ui-monospace, Consolas, monospace);
		color: #e5e7eb;
		background: #141333;
		border: 2px solid var(--px-ink);
	}
	.sandbox__console-title {
		margin: 0 0 0.25rem;
		font: 400 0.65rem var(--px-font);
		color: #a8a4cc;
	}
	.sandbox__console ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.sandbox__console ol:empty::before {
		content: 'Пока пусто. Напиши console.log("привет")';
		color: #a8a4cc;
	}
	/* Строки консоли создаёт JS — их стили через :global */
	.sandbox__console :global(li + li) {
		border-top: 1px solid #34326a;
	}
	.sandbox__console :global(.is-error) {
		color: #ffab8a;
	}
	.sandbox__console :global(.is-warn) {
		color: #ffe08a;
	}
	.sandbox__checks {
		margin-top: 0.75rem;
		padding: 0.6rem 0.75rem;
	}
	.sandbox__checks:empty {
		display: none;
	}
	.sandbox__checks :global(p) {
		margin: 0;
		font: 400 0.75rem/1.6 var(--px-font);
	}
	/* Невыполненные проверки — строками с крестиком */
	.sandbox__checks :global(ul) {
		margin: 0.4rem 0 0;
		padding: 0;
		list-style: none;
	}
	.sandbox__checks :global(li) {
		margin: 0;
		padding: 0.2rem 0 0.2rem 1.4rem;
		font-size: var(--sl-text-sm);
		text-indent: -1.4rem;
	}
	.sandbox__checks :global(li)::before {
		content: '✗';
		display: inline-block;
		width: 1.4rem;
		text-indent: 0;
		color: var(--px-brick);
		font-weight: 700;
	}
	.is-wip {
		border-left: 6px solid var(--px-brick);
		background: var(--sl-color-black);
	}
	.is-ok {
		border-left: 6px solid var(--px-grass);
		background: var(--sl-color-black);
	}
	.sandbox__reset {
		margin-top: 0.9rem !important;
	}
</style>
