---
// Песочница-разминка. Задача, стартовый код и автопроверки берутся из поля warmup во frontmatter.
// Черновик сохраняется в браузере, «Сбросить» возвращает стартовый код.
import type { CollectionEntry } from 'astro:content';
import { url } from '~/lib/route';
import practices from '~/data/block-practices.json';
import { DIFFICULTIES } from '~/lib/storage';
interface Props { practice?: CollectionEntry<'docs'> }
const { practice } = Astro.props;
const entry = practice ?? Astro.locals.starlightRoute.entry;
const returns = Object.fromEntries(Object.entries(practices).filter(([, id]) => id === entry.id).map(([block]) => [block, url('blocks/' + block + '/')]));
const w = entry.data.warmup;
const hasJs = w?.js !== undefined; // есть поле js — разминка на JavaScript
const manual = entry.data.lesson === undefined || entry.data.lesson >= 3;
const answer = w?.answer;
const language = answer && { html: 'HTML', css: 'CSS', js: 'JavaScript' }[answer.field];
const example = answer && w?.[answer.field]?.replace('___', () => answer.missing);
if (answer && (!example || w?.[answer.field]?.split('___').length !== 2)) {
	throw new Error(`В задании ${entry.id} нужен ровно один пропуск в поле ${answer.field}`);
}
const normal = w?.normal;
const variants = answer && normal && w?.hard && {
	easy: { task: w.task, html: w.html, css: w.css, js: w.js },
	normal: {
		task: normal.task,
		html: w.html,
		css: w.css,
		js: w.js,
		[answer.field]: w[answer.field]!.replace('___', () => normal.replacement),
	},
	hard: w.hard,
};
---

{
	w && (
		<nav-sandbox class="sandbox not-content" data-id={entry.id} data-html={w.html} data-css={w.css} data-checks={JSON.stringify(w.checks)} data-js={hasJs ? w.js : undefined} data-manual={manual ? '' : undefined} data-width={w.width} data-check-storage={JSON.stringify(w.checkStorage ?? {})} data-return-blocks={practice ? undefined : JSON.stringify(returns)} data-answer-field={answer?.field} data-variants={variants ? JSON.stringify(variants) : undefined}>
			{!practice && entry.data.lesson === undefined && <span id="разминка" />}
			{variants && normal && (
				<>
					<p class="sandbox__difficulty">Сложность: <b>{DIFFICULTIES.normal}</b>. <button type="button" data-open-profile>Изменить в профиле</button></p>
					<div class="sandbox__theory" hidden>
						<p><strong>Как это работает.</strong> {normal.explanation}</p>
						<pre><code>{normal.example}</code></pre>
					</div>
				</>
			)}
			<p class="sandbox__task">
				<strong>Задача:</strong> <span>{variants?.normal.task ?? w.task}</span>
			</p>
			{answer && (
				<details class="sandbox__answer" data-pagefind-ignore hidden={!!variants}>
					<summary>Показать полный ответ</summary>
					<p>Впиши <code>{answer.missing}</code> вместо <code>___</code> в поле {language}.</p>
					<pre><code>{example}</code></pre>
					<button type="button" class="sandbox__apply-answer a-btn--sky">Вставить готовый ответ</button>
					<p>Кнопка заменит код в редакторах. Затем нажми «Проверить».</p>
				</details>
			)}
			{answer && <p class="sandbox__draft-note" hidden>Открыт твой черновик. Чтобы вернуть стартовый код, нажми «Сбросить к началу».</p>}
			<div class="sandbox__grid">
				<div class="sandbox__editors">
					<label>
						HTML
						<textarea name="html" spellcheck="false" autocapitalize="off" wrap="off" rows="10" />
					</label>
					<label>
						CSS
						<textarea name="css" spellcheck="false" autocapitalize="off" wrap="off" rows="8" />
					</label>
					{hasJs && (
						<label>
							JavaScript
							<textarea name="js" spellcheck="false" autocapitalize="off" wrap="off" rows="10" />
						</label>
					)}
					<p class="sandbox__tip">Tab — отступ. Чтобы уйти из поля клавиатурой: Esc, потом Tab.</p>
				</div>
				<div class="sandbox__result">
					{w.width && <p class="sandbox__width">Превью шириной {w.width} px — как на телефоне</p>}
					<div class="sandbox__frame">
						<iframe
							title="Результат разминки"
							sandbox={hasJs ? undefined : 'allow-same-origin'}
							style={w.width ? `width:${w.width}px` : undefined}
						/>
						<div class="sandbox__clear px-font" role="status" hidden>
							<span class="sandbox__coin" aria-hidden="true" />
							<b>Разминка пройдена!</b>
							<span>+1 звезда</span>
						</div>
						{/* Для JS-разминок проверки идут в скрытой копии: они нажимают кнопки и не должны менять то, что видит ученик */}
						{(hasJs || manual) && (
							<iframe
								class="sandbox__checker"
								title="Проверка"
								aria-hidden="true"
								tabindex="-1"
								sandbox={manual ? 'allow-scripts' : undefined}
								style={w.width ? `width:${w.width}px` : undefined}
							/>
						)}
					</div>
					{hasJs && (
						<div class="sandbox__console" aria-live="polite">
							<p class="sandbox__console-title">Консоль</p>
							<ol />
						</div>
					)}
					<div class="sandbox__checks" aria-live="polite" />
					{manual && w.checks.length > 0 && <button type="button" class="sandbox__check a-btn--go" disabled>Проверить</button>}
					<a class="sandbox__return a-btn--go" hidden>К блоку</a>
					<button type="button" class="sandbox__reset">Сбросить к началу</button>
				</div>
			</div>
		</nav-sandbox>
	)
}

<script>
	import { DIFFICULTIES, difficultyOf, load, update, PRACTICE_VERSION, type Difficulty } from '~/lib/storage';
	import { runChecks, unclosedTag, type Check } from '~/lib/checks';
	import { srcdoc } from '~/lib/srcdoc';
	import { checkFrame } from '~/lib/check-frame';

	// Частые ошибки JavaScript — переводим на понятный язык
	const explain = (text: string) =>
		text
			.replace(/^(Uncaught )?SyntaxError: /, 'синтаксическая ошибка — проверь скобки и кавычки. ')
			.replace(/^(Uncaught )?\w*Error: /, '')
			.replace(/Cannot (read|set) propert(y|ies) of null.*/, 'querySelector ничего не нашёл (получился null) — проверь селектор и что элемент есть в HTML')
			.replace(/Cannot (read|set) propert(y|ies) of undefined.*/, 'обращение к тому, чего нет (undefined) — проверь имя переменной или свойства')
			.replace(/(\S+) is not defined/, 'имя «$1» не найдено — опечатка или переменная не объявлена')
			.replace(/(\S+) is not a function/, '«$1» — не функция: проверь название метода и скобки');

	class Sandbox extends HTMLElement {
		connectedCallback() {
			const { id = '', html = '', css = '', js } = this.dataset;
			const hasJs = js !== undefined;
			const manual = this.hasAttribute('data-manual');
			const checks: Check[] = JSON.parse(this.dataset.checks || '[]');
			const fields = [...this.querySelectorAll('textarea')];
			const [htmlBox, cssBox, jsBox] = fields;
			const answerField = fields.find(box => box.name === this.dataset.answerField);
			const answer = this.querySelector<HTMLDetailsElement>('.sandbox__answer');
			const draftNote = this.querySelector<HTMLElement>('.sandbox__draft-note');
			const variants = this.dataset.variants && JSON.parse(this.dataset.variants) as Record<Difficulty, { task: string; html: string; css: string; js?: string }>;
			const starter = { html, css, js };
			let difficulty = variants ? difficultyOf(load().profile?.difficulty) : 'easy';
			let draftKey = id;
			const frame = this.querySelector<HTMLIFrameElement>('iframe:not(.sandbox__checker)')!;
			// Где запускаем проверки: для JS — в скрытой копии, иначе прямо в превью
			const checker = this.querySelector<HTMLIFrameElement>('.sandbox__checker') ?? frame;
			const out = this.querySelector<HTMLElement>('.sandbox__checks')!;
			const logList = this.querySelector('.sandbox__console ol');
			const clear = this.querySelector<HTMLElement>('.sandbox__clear')!;
			const button = this.querySelector<HTMLButtonElement>('.sandbox__check');
			const returnLink = this.querySelector<HTMLAnchorElement>('.sandbox__return')!;
			const returnBlock = new URLSearchParams(location.search).get('block') ?? '';
			const returnBlocks = JSON.parse(this.dataset.returnBlocks || '{}');
			if (Object.hasOwn(returnBlocks, returnBlock)) returnLink.href = returnBlocks[returnBlock];
			const showReturn = () => {
				returnLink.hidden = !returnLink.hasAttribute('href') || load().practicePass?.[id] !== PRACTICE_VERSION;
			};
			showReturn();
			let pending: AbortController | undefined;

			const putCode = (code: { html: string; css: string; js?: string }) => {
				htmlBox.value = code.html;
				cssBox.value = code.css;
				if (jsBox) jsBox.value = code.js ?? '';
			};
			const modeStarter = () => variants ? variants[difficulty] : starter;
			const showMode = () => {
				draftKey = difficulty === 'easy' ? id : id + ':' + difficulty;
				const code = modeStarter();
				const draft = load().drafts[draftKey];
				putCode({ ...code, ...draft });
				if (draftNote) draftNote.hidden = !draft;
				if (answer) {
					answer.hidden = difficulty !== 'easy';
					answer.open = false;
				}
				if (variants) {
					this.dataset.difficulty = difficulty;
					this.querySelector('.sandbox__task span')!.textContent = variants[difficulty].task;
					this.querySelector('.sandbox__difficulty b')!.textContent = DIFFICULTIES[difficulty];
					this.querySelector<HTMLElement>('.sandbox__theory')!.hidden = difficulty !== 'normal';
				}
			};

			// Консоль: сообщения приходят из превью через postMessage
			window.addEventListener('message', (e) => {
				if (!logList || e.source !== frame.contentWindow || !e.data?.sandbox) return;
				const { kind, text, line } = e.data;
				if (!['log', 'info', 'warn', 'error'].includes(kind) || typeof text !== 'string') return;
				const li = document.createElement('li');
				li.className = 'is-' + kind;
				li.textContent = kind === 'error' ? `Ошибка${line > 0 ? ` в строке ${line}` : ''}: ${explain(text)}` : text;
				logList.append(li);
			});

			const showResults = (results: ReturnType<typeof runChecks>) => {
				// Незакрытый тег — первой строкой: из-за него остальные проверки врут
				const open = unclosedTag(htmlBox.value);
				if (open) results.unshift({ ok: false, message: `Похоже, не закрыт тег <${open}> — найди, где он должен закончиться, и поставь </${open}>` });
				const failed = results.filter((r) => !r.ok);
				// classList, а не className: иначе стирается класс, по которому Astro применяет стили
				out.classList.toggle('is-wip', failed.length > 0);
				out.classList.toggle('is-ok', failed.length === 0);
				out.innerHTML = '';
				const head = document.createElement('p');
				head.textContent = failed.length
					? `Проверка: ${results.length - failed.length} из ${results.length}. Осталось:`
					: 'Всё верно! Разминка пройдена.';
				out.append(head);
				if (failed.length) {
					const ul = document.createElement('ul');
					for (const f of failed) ul.append(Object.assign(document.createElement('li'), { textContent: f.message }));
					out.append(ul);
				}
				// Первое решение: записываем и показываем «Разминка пройдена»
				if (!failed.length) {
					const progress = load();
					const first = !progress.solved.includes(id);
					if (first || (manual && progress.practicePass?.[id] !== PRACTICE_VERSION)) {
						update(p => {
							if (first) p.solved.push(id);
							if (manual) (p.practicePass ??= {})[id] = PRACTICE_VERSION;
						});
					}
					showReturn();
					if (first) {
						clear.hidden = false;
						setTimeout(() => (clear.hidden = true), 2600);
					}
				}
			};

			const markup = () => srcdoc(htmlBox.value, cssBox.value, jsBox?.value);
			const render = () => {
				if (logList) logList.innerHTML = '';
				const doc = markup();
				frame.srcdoc = doc;
				if (!manual && checker !== frame) checker.srcdoc = doc;
			};
			if (!manual) {
				checker.addEventListener('load', () => {
					if (checks.length && checker.contentDocument) showResults(runChecks(checker.contentDocument, checks));
				});
			}

			const invalidate = () => {
				if (!button) return;
				if (pending) {
					pending.abort();
				}
				pending = undefined;
				out.classList.remove('is-ok', 'is-wip');
				out.textContent = '';
				button.disabled = false;
			};

			if (button) {
				button.disabled = false;
				button.addEventListener('click', async () => {
					if (difficulty === 'easy' && answerField?.value.includes('___')) {
						showResults([{ ok: false, message: 'Заполни пропуск ___ или нажми «Показать полный ответ».' }]);
						return;
					}
					const request = new AbortController();
					pending = request;
					button.disabled = true;
					out.classList.remove('is-ok', 'is-wip');
					out.textContent = 'Проверяем…';
					const doc = markup();
					const width = Number(this.dataset.width) || 768;
					const storage = JSON.parse(this.dataset.checkStorage || '{}');
					const widths = new Set(checks.flatMap(check => check.widths ?? [width]));
					try {
						const results = [];
						for (const size of widths) {
							const rules = checks.filter(check => (check.widths ?? [width]).includes(size));
							results.push(...await checkFrame(checker, doc, rules, size, storage, request.signal));
						}
						if (!request.signal.aborted) showResults(results);
					} catch (error) {
						if (!request.signal.aborted) showResults([{ ok: false, message: (error as Error).message }]);
					} finally {
						if (pending === request) {
							pending = undefined;
							button.disabled = false;
						}
					}
				});
			}

			let timer: number | undefined;
			const saveDraft = () => {
				timer = undefined;
				update(p => { p.drafts[draftKey] = { html: htmlBox.value, css: cssBox.value, js: jsBox?.value }; });
			};
			const onInput = () => {
				invalidate();
				clearTimeout(timer);
				timer = window.setTimeout(
					() => {
						render();
						saveDraft();
					},
					hasJs ? 800 : 400 // JS ждём дольше: недописанный код почти всегда с ошибкой
				);
			};
			const markHint = () => {
				if (!load().hints.includes(id)) update(p => p.hints.push(id));
			};
			answer?.addEventListener('toggle', () => {
				if (answer.open) markHint();
			});
			if (answer && answerField) {
				answer.querySelector('button')!.addEventListener('click', () => {
					markHint();
					putCode(starter);
					answerField.value = answer.querySelector('pre code')!.textContent!;
					onInput();
					if (draftNote) draftNote.hidden = true;
					answer.open = false;
					button?.focus();
				});
			}

			let escaped = false; // после Esc Tab снова переводит фокус, а не вставляет отступ
			for (const box of fields) {
				box.addEventListener('input', onInput);
				box.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') return void (escaped = true);
					if (e.key !== 'Tab' || escaped) return void (escaped = false);
					e.preventDefault();
					box.setRangeText('  ', box.selectionStart, box.selectionEnd, 'end');
					onInput();
				});
			}

			this.querySelector('.sandbox__reset')!.addEventListener('click', () => {
				clearTimeout(timer);
				timer = undefined;
				invalidate();
				putCode(modeStarter());
				if (draftNote) draftNote.hidden = true;
				update((p) => delete p.drafts[draftKey]);
				render();
			});

			if (variants) window.addEventListener('nav-progress', () => {
				const next = difficultyOf(load().profile?.difficulty);
				if (next === difficulty) return;
				difficulty = next;
				if (timer !== undefined) {
					clearTimeout(timer);
					saveDraft();
				}
				invalidate();
				showMode();
				render();
			});
			showMode();
			render();
		}
	}
	customElements.define('nav-sandbox', Sandbox);
</script>

<style>
	/* Песочница — «игровой экран» в пиксельной рамке */
	.sandbox {
		display: block;
		margin: 2rem 3px 1.5rem;
		padding: 1rem;
		background: var(--sl-color-gray-6);
		border-radius: var(--a-r-card);
		box-shadow:
			inset 0 0 0 2px var(--a-line),
			0 5px 0 var(--a-edge);
	}
	.sandbox__task {
		margin: 0 0 1rem;
	}
	.sandbox__answer {
		margin-bottom: 1rem;
		padding: .65rem .85rem;
		border: 1px solid var(--a-line);
		border-radius: var(--a-r-card);
	}
	.sandbox__answer summary {
		cursor: pointer;
		font-weight: 700;
	}
	.sandbox__answer pre {
		overflow: auto;
		max-height: 16rem;
		padding: .65rem;
		background: var(--a-bg);
	}
	.sandbox__theory pre {
		overflow: auto;
		padding: .65rem;
		background: var(--a-bg);
	}
	.sandbox__difficulty button {
		color: var(--sl-color-text-accent);
		text-decoration: underline;
	}
	.sandbox__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
		gap: 1rem;
	}
	.sandbox label {
		display: block;
		font: 400 0.7rem var(--px-font);
		margin-bottom: 0.75rem;
	}
	/* Редактор всегда тёмный, как экран консоли */
	.sandbox textarea {
		display: block;
		width: 100%;
		margin-top: 0.25rem;
		padding: 0.5rem;
		font: 0.875rem/1.5 var(--__sl-font-mono, ui-monospace, Consolas, monospace);
		tab-size: 2;
		resize: vertical;
		color: #e8e6f5;
		background: #141333;
		border: 2px solid var(--px-ink);
				caret-color: var(--px-coin);
	}
	.sandbox__tip {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.sandbox__grid > * {
		min-width: 0; /* иначе превью 375 px растягивает колонку шире экрана */
	}
	.sandbox__width {
		margin: 0 0 0.25rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.sandbox__frame {
		position: relative;
		overflow-x: auto; /* узкое превью на телефоне прокручивается внутри, а не всей страницей */
	}
	.sandbox iframe {
		display: block;
		width: 100%;
		height: 16rem;
		border: 2px solid var(--px-ink);
		background: #fff;
		resize: vertical;
	}
	.sandbox iframe.sandbox__checker {
		position: absolute;
		top: 0;
		left: 0;
		border: 0;
		max-width: none;
		visibility: hidden;
		height: 16rem;
		pointer-events: none;
	}
	/* «Разминка пройдена!» — появляется один раз, когда разминка решена впервые */
	.sandbox__clear {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		align-items: center;
		justify-content: center;
		text-align: center;
		color: #fff;
		background: #1b1a3ff5;
		animation: clear-in 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) both;
	}
	.sandbox__clear[hidden] {
		display: none;
	}
	.sandbox__clear b {
		font-size: 1.05rem;
		font-weight: 400;
		color: var(--px-coin);
		text-shadow: 3px 3px 0 #000;
	}
	.sandbox__coin {
		width: 24px;
		height: 32px;
		background: var(--px-coin);
		box-shadow:
			inset -6px 0 0 #c98f00,
			0 -3px 0 0 #7a5600,
			0 3px 0 0 #7a5600,
			-3px 0 0 0 #7a5600,
			3px 0 0 0 #7a5600;
		animation: coin-jump 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 2;
	}
	@keyframes clear-in {
		from {
			opacity: 0;
		}
	}
	@keyframes coin-jump {
		50% {
			transform: translateY(-18px);
		}
	}
	.sandbox__console {
		margin-top: 0.75rem;
		padding: 0.5rem 0.75rem;
		font: 0.8125rem/1.4 var(--__sl-font-mono, ui-monospace, Consolas, monospace);
		color: #e5e7eb;
		background: #141333;
		border: 2px solid var(--px-ink);
	}
	.sandbox__console-title {
		margin: 0 0 0.25rem;
		font: 400 0.65rem var(--px-font);
		color: #a8a4cc;
	}
	.sandbox__console ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.sandbox__console ol:empty::before {
		content: 'Пока пусто. Напиши console.log("привет")';
		color: #a8a4cc;
	}
	/* Строки консоли создаёт JS — их стили через :global */
	.sandbox__console :global(li + li) {
		border-top: 1px solid #34326a;
	}
	.sandbox__console :global(.is-error) {
		color: #ffab8a;
	}
	.sandbox__console :global(.is-warn) {
		color: #ffe08a;
	}
	.sandbox__checks {
		margin-top: 0.75rem;
		padding: 0.6rem 0.75rem;
	}
	.sandbox__checks:empty {
		display: none;
	}
	.sandbox__checks :global(p) {
		margin: 0;
		font: 400 0.75rem/1.6 var(--px-font);
	}
	/* Невыполненные проверки — строками с крестиком */
	.sandbox__checks :global(ul) {
		margin: 0.4rem 0 0;
		padding: 0;
		list-style: none;
	}
	.sandbox__checks :global(li) {
