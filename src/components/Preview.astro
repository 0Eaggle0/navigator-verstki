---
// Пример кода с живым превью. Использование в шаге:
// <Preview html="<h1>Привет</h1>" css="h1 { color: tomato; }" />
import { Code } from '@astrojs/starlight/components';
import { srcdoc } from '~/lib/srcdoc';

interface Props {
	html: string;
	css?: string;
	height?: number;
}
const { html, css = '', height = 180 } = Astro.props;
---

<figure class="preview not-content">
	<Code code={html} lang="html" title="index.html" />
	{css && <Code code={css} lang="css" title="style.css" />}
	<figcaption>Как это выглядит в браузере:</figcaption>
	<iframe title="Превью примера" srcdoc={srcdoc(html, css)} sandbox="allow-same-origin" style={`height:${height}px`}></iframe>
</figure>

<style>
	.preview {
		margin-block: 1.5rem;
	}
	.preview figcaption {
		margin: 0.75rem 0 0.25rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.preview iframe {
		width: 100%;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: #fff;
	}
</style>
