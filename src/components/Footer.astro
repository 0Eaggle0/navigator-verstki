---
// Подвал сайта (заменяет подвал Starlight): кнопки «прошлый / следующий уровень»
// и полоса с разделами сайта.
import Pagination from 'virtual:starlight/components/Pagination';
import { svg } from '~/lib/sprites';
import { url } from '~/lib/route';

const columns = [
	{
		title: 'Учимся',
		links: [
			{ label: 'Карта уроков', href: url('route/') },
			{ label: 'Задачник и игры', href: url('tasks/') },
			{ label: 'Шпаргалки и ссылки', href: url('cheatsheets/') },
		],
	},
	{
		title: 'Делаем сайт',
		links: [
			{ label: 'Блоки для сайта', href: url('blocks/') },
			{ label: 'Стартовый шаблон', href: url('starter/index.html') },
			{ label: 'Шаблон секции для команды', href: url('starter/section.html') },
		],
	},
	{
		title: 'Модератору',
		links: [
			{ label: 'Для модератора', href: url('moderator/') },
			{ label: 'Готовые сайты команд', href: url('moderator/sites/') },
			{ label: 'Чек-лист сдачи', href: url('lesson-7/7-4-checklist/') },
		],
	},
];
---

<footer class="a-footer-wrap">
	<Pagination />
	<div class="a-footer not-content">
		<div class="a-footer__brand">
			<span class="a-footer__byte" set:html={svg('byte', 48)} />
			<p>
				<b>Навигатор вёрстки</b>
				От макета в Figma до своего сайта по ссылке — за 7 занятий.
			</p>
		</div>
		{
			columns.map((c) => (
				<div class="a-footer__col">
					<p class="a-footer__title">{c.title}</p>
					<ul>
						{c.links.map((l) => (
							<li>
								<a href={l.href}>{l.label}</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
		<p class="a-footer__bottom">
			<span>Проектная школа ОмГТУ, «Веб-разработка», 2026</span>
			<span>Прогресс и звёзды хранятся в этом браузере</span>
		</p>
	</div>
</footer>

<style>
	.a-footer-wrap {
		display: flex;
		flex-direction: column;
		gap: 3rem;
		margin-top: 3rem;
		container-type: inline-size; /* колонки подвала — по ширине контента, а не окна */
	}
	.a-footer {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
		gap: 2rem 1.5rem;
		padding: 2rem 1.75rem 1.25rem;
		background: var(--a-surface);
		border-radius: var(--a-r-card);
		box-shadow:
			inset 0 0 0 2px var(--a-line),
			0 6px 0 var(--a-edge);
	}
	.a-footer__brand {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
	}
	.a-footer__byte {
		flex: none;
		display: grid;
		place-items: center;
		width: 4rem;
		height: 4rem;
		background: var(--a-surface-2);
		border-radius: 16px;
	}
	.a-footer__brand p {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--a-muted);
	}
	.a-footer__brand b {
		display: block;
		margin-bottom: 0.3rem;
		font: 800 1rem var(--a-font);
		color: var(--a-text);
	}
	.a-footer__title {
		margin: 0 0 0.6rem;
		font: 700 0.85rem var(--a-font);
		color: var(--a-text);
	}
	.a-footer ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.a-footer li + li {
		margin-top: 0.35rem;
	}
	.a-footer a {
		font-size: var(--sl-text-sm);
		color: var(--a-muted);
		text-decoration: none;
	}
	.a-footer a:hover {
		color: var(--a-sky);
		text-decoration: underline;
	}
	.a-footer__bottom {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		justify-content: space-between;
		margin: 0;
		padding-top: 1rem;
		font-size: var(--sl-text-xs);
		color: var(--a-muted);
		border-top: 2px solid var(--a-line);
	}
	@container (max-width: 44rem) {
		.a-footer {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
		.a-footer__brand {
			grid-column: 1 / -1;
		}
	}
</style>
