---
// Готовый блок: превью + код + кнопки «Скопировать». Код лежит в src/blocks/<id>.html и <id>.css,
// у блоков с поведением — ещё <id>.js
import { Code } from '@astrojs/starlight/components';
import { srcdoc } from '~/lib/srcdoc';

interface Props {
	id: string;
	height?: number;
}
const { id, height = 320 } = Astro.props;
const files = import.meta.glob<string>('/src/blocks/*', { query: '?raw', import: 'default', eager: true });
const html = files[`/src/blocks/${id}.html`];
const css = files[`/src/blocks/${id}.css`];
const js = files[`/src/blocks/${id}.js`]; // может не быть
if (html === undefined || css === undefined) throw new Error(`Нет файлов блока src/blocks/${id}.html / .css`);
const tabs = [
	{ kind: 'html', code: html, where: `Вставь в index.html, внутрь <body>` },
	{ kind: 'css', code: css, where: 'Вставь в конец style.css' },
	...(js ? [{ kind: 'js', code: js, where: 'Вставь в script.js — он подключён в конце <body>' }] : []),
];
---

<nav-block class="block not-content" data-html={html} data-css={css} data-js={js}>
	<iframe title="Превью блока" srcdoc={srcdoc(html, css, js)} sandbox={js ? undefined : 'allow-same-origin'} style={`height:${height}px`}></iframe>
	<div class="block__code">
		<div class="block__bar">
			<div class="block__tabs" role="tablist" aria-label="Код блока">
				{tabs.map((t, i) => (
					<button type="button" role="tab" id={`${id}-tab-${t.kind}`} aria-controls={`${id}-panel-${t.kind}`} aria-selected={String(i === 0)} data-kind={t.kind}>
						{t.kind.toUpperCase()}
					</button>
				))}
			</div>
			<button type="button" class="a-btn--go" data-copy>Скопировать HTML</button>
		</div>
		{tabs.map((t, i) => (
			<div role="tabpanel" id={`${id}-panel-${t.kind}`} aria-labelledby={`${id}-tab-${t.kind}`} hidden={i > 0}>
				<p class="block__where">{t.where}</p>
				<Code code={t.code} lang={t.kind} />
			</div>
		))}
		<p class="block__status" aria-live="polite"></p>
	</div>
</nav-block>

<script>
	class Block extends HTMLElement {
		connectedCallback() {
			const status = this.querySelector('.block__status')!;
			const copy = this.querySelector<HTMLButtonElement>('[data-copy]')!;
			const tabs = [...this.querySelectorAll<HTMLButtonElement>('[role=tab]')];
			let kind = 'html';
			// Вкладка HTML / CSS / JS: показываем её код, кнопка копирует именно его
			tabs.forEach((tab) =>
				tab.addEventListener('click', () => {
					kind = tab.dataset.kind!;
					tabs.forEach((t) => {
						t.setAttribute('aria-selected', String(t === tab));
						this.querySelector<HTMLElement>('#' + t.getAttribute('aria-controls'))!.hidden = t !== tab;
					});
					copy.textContent = `Скопировать ${kind.toUpperCase()}`;
					status.textContent = '';
				})
			);
			copy.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(this.dataset[kind]!);
					status.textContent = `${kind.toUpperCase()} скопирован ✓`;
				} catch {
					status.textContent = 'Не получилось скопировать — выдели код и нажми Ctrl+C';
				}
			});
		}
	}
	customElements.define('nav-block', Block);
</script>

<style>
	.block iframe {
		width: 100%;
		background: #fff;
		border: 0;
		border-radius: var(--a-r-card);
		box-shadow:
			inset 0 0 0 2px var(--a-line),
			0 6px 0 var(--a-edge);
		resize: vertical;
	}
	.block__code {
		margin-top: 1.5rem;
		padding: 1rem;
		background: var(--a-surface);
		border-radius: var(--a-r-card);
		box-shadow:
			inset 0 0 0 2px var(--a-line),
			0 6px 0 var(--a-edge);
	}
	.block__bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
		justify-content: space-between;
	}
	.block__tabs {
		display: flex;
		gap: 0.4rem;
	}
	.block .block__tabs button[aria-selected='true'] {
		color: var(--a-ink);
		background: var(--a-coin);
		box-shadow: 0 5px 0 var(--a-coin-edge);
	}
	.block__where {
		margin: 1rem 0 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--a-muted);
	}
	.block__status {
		min-height: 1.4em;
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--a-go);
	}
	.block :global(.expressive-code pre) {
		max-height: 28rem;
	}
</style>
