---
// «Кто что делает» — задачи шага для четырёх участников команды. Берутся из поля team во frontmatter:
//   team:
//     - task: "что делает участник 1"   ← часть 1 (src/data/parts.json)
//       hint: "подсказка"
//     - task: …                          ← часть 2, 3, 4 по порядку
// Своя задача подсвечивается по профилю (часть сайта), её можно поменять прямо здесь.
import { parts } from '~/data/parts.json';

const { entry } = Astro.locals.starlightRoute;
const team = entry.data.team ?? [];
---

{
	team.length > 0 && (
		<nav-team class="team not-content">
			<div class="team__head">
				<h3>Кто что делает</h3>
				<label>
					Я делаю
					<select>
						<option value="0">— выбери свою часть —</option>
						{parts.map((p) => (
							<option value={p.n}>
								{p.n}. {p.title}
							</option>
						))}
					</select>
				</label>
			</div>
			<ol class="team__list">
				{team.map((t, i) => (
					<li class={`team__item w-${[1, 3, 4, 6][i]}`} data-part={i + 1}>
						<p class="team__part">
							<b>{i + 1}</b> {parts[i]?.title}
							<span class="team__me">это ты</span>
						</p>
						<p class="team__task">{t.task}</p>
						{t.hint && (
							<details>
								<summary>Подсказка</summary>
								<p>{t.hint}</p>
							</details>
						)}
					</li>
				))}
			</ol>
			<p class="team__note">
				Части закреплены по номерам участников. Договорились иначе — выбери свою часть вверху, это сохранится в профиле.
			</p>
		</nav-team>
	)
}

<script>
	import { load, update } from '~/lib/storage';

	class Team extends HTMLElement {
		connectedCallback() {
			const select = this.querySelector('select')!;
			const show = () => {
				const part = load().profile?.part ?? 0;
				select.value = String(part);
				this.querySelectorAll<HTMLElement>('.team__item').forEach((li) => li.classList.toggle('is-me', +li.dataset.part! === part));
				this.classList.toggle('has-me', part > 0);
			};
			select.addEventListener('change', () => {
				const part = +select.value;
				if (!load().profile) {
					// Профиля ещё нет — открываем окно: там и имя, и часть сайта
					document.querySelector<HTMLElement>('.profile__chip')?.click();
					select.value = '0';
					return;
				}
				update((p) => (p.profile!.part = part || undefined));
			});
			show();
			window.addEventListener('nav-progress', show);
		}
	}
	customElements.define('nav-team', Team);
</script>

<style>
	.team {
		display: block;
		margin-block: 2rem;
	}
	.team__head {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1rem;
	}
	.team__head h3 {
		margin: 0;
		font: 800 1.2rem var(--a-font);
		color: var(--a-text);
	}
	.team__head label {
		display: flex;
		gap: 0.6rem;
		align-items: center;
		font: 700 0.85rem var(--a-font);
		color: var(--a-muted);
	}
	.team__head select {
		padding: 0.5rem 0.8rem;
		font: 600 0.9rem var(--sl-font);
		color: var(--a-text);
		background: var(--a-surface);
		border: 0;
		border-radius: 12px;
		box-shadow: inset 0 0 0 2px var(--a-line);
	}
	.team__head select:focus-visible {
		outline: 3px solid var(--a-sky);
	}
	.team__list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.team__item {
		margin: 0;
		padding: 1rem 1.1rem;
		background: var(--a-surface);
		border-radius: var(--a-r-card);
		box-shadow:
			inset 0 0 0 2px var(--a-line),
			0 5px 0 var(--a-edge);
		transition:
			opacity 0.2s,
			transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	/* Своя часть — обводка цвета части, остальные чуть приглушены */
	.team.has-me .team__item:not(.is-me) {
		opacity: 0.7;
	}
	.team__item.is-me {
		box-shadow:
			inset 0 0 0 3px var(--w),
			0 5px 0 var(--w-edge);
		transform: translateY(-3px);
	}
	.team__part {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		margin: 0;
		font: 700 0.85rem var(--a-font);
		color: var(--a-text);
	}
	.team__part b {
		display: grid;
		place-items: center;
		width: 1.7rem;
		height: 1.7rem;
		font-weight: 800;
		color: var(--a-ink);
		background: var(--w);
		border-radius: 50%;
		box-shadow: 0 3px 0 var(--w-edge);
	}
	.team__me {
		display: none;
		margin-inline-start: auto;
		padding: 0.1rem 0.55rem;
		font-size: 0.7rem;
		color: var(--a-ink);
		background: var(--w);
		border-radius: 999px;
	}
	.team__item.is-me .team__me {
		display: inline-block;
	}
	.team__task {
		margin: 0.6rem 0 0;
		line-height: 1.5;
	}
	.team details {
		margin-top: 0.6rem;
	}
	.team summary {
		width: fit-content;
		font: 700 0.8rem var(--a-font);
		color: var(--a-sky);
		cursor: pointer;
	}
	.team details p {
		margin: 0.4rem 0 0;
		padding: 0.6rem 0.8rem;
		font-size: var(--sl-text-sm);
		background: var(--a-surface-2);
		border-radius: 12px;
	}
	.team__note {
		margin: 1rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--a-muted);
	}
	@media (max-width: 40rem) {
		.team__list {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
