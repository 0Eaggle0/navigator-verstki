---
// Переключатель темы (заменяет выпадающий список Starlight): круглая кнопка «день / ночь».
// Хранит выбор там же, где Starlight: localStorage['starlight-theme'].
---

<starlight-theme-select>
	<button type="button" class="theme" aria-label="Переключить тему: сейчас ночь" title="День / ночь">
		<svg class="theme__sun" viewBox="0 0 24 24" aria-hidden="true">
			<circle cx="12" cy="12" r="5" fill="currentColor"></circle>
			<g stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
				<path d="M12 1.5v2.5M12 20v2.5M1.5 12h2.5M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"></path>
			</g>
		</svg>
		<svg class="theme__moon" viewBox="0 0 24 24" aria-hidden="true">
			<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="currentColor"></path>
		</svg>
	</button>
</starlight-theme-select>

{/* Starlight вызывает это из своего ThemeProvider — без select просто ничего не делает */}
<script is:inline>
	StarlightThemeProvider.updatePickers();
</script>

<script>
	const KEY = 'starlight-theme';
	const store = (t: string) => {
		try {
			localStorage.setItem(KEY, t);
		} catch {
			// нет хранилища — тема просто не запомнится
		}
	};

	class ThemeToggle extends HTMLElement {
		connectedCallback() {
			const btn = this.querySelector('button')!;
			const sync = () => {
				const light = document.documentElement.dataset.theme === 'light';
				btn.setAttribute('aria-label', `Переключить тему: сейчас ${light ? 'день' : 'ночь'}`);
				btn.classList.toggle('is-light', light);
			};
			sync();
			btn.addEventListener('click', () => {
				const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
				document.documentElement.dataset.theme = next;
				store(next);
				// Кнопок две (в шапке и в мобильном меню) — обновляем все
				document.querySelectorAll('starlight-theme-select').forEach((el) => (el as ThemeToggle).sync?.());
			});
			this.sync = sync;
		}
		sync?: () => void;
	}
	customElements.define('starlight-theme-select', ThemeToggle);
</script>

<style>
	.theme {
		position: relative;
		display: grid;
		place-items: center;
		width: 2.6rem;
		height: 2.6rem;
		margin: 0 0 4px;
		padding: 0;
		color: var(--a-coin);
		background: var(--a-surface);
		border: 0;
		border-radius: 50%;
		box-shadow:
			inset 0 0 0 2px var(--a-line),
			0 4px 0 var(--a-edge);
		cursor: pointer;
		overflow: hidden;
		transition: transform 0.08s;
	}
	.theme:active {
		transform: translateY(4px);
		box-shadow: inset 0 0 0 2px var(--a-line);
	}
	.theme:focus-visible {
		outline: 3px solid var(--a-sky);
		outline-offset: 3px;
	}
	.theme svg {
		position: absolute;
		width: 1.35rem;
		height: 1.35rem;
		transition:
			transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
			opacity 0.2s;
	}
	/* Ночью видна луна, днём — солнце; смена — поворотом */
	.theme__sun {
		opacity: 0;
		transform: rotate(-90deg) scale(0.4);
		color: #e89b00;
	}
	.theme.is-light .theme__sun {
		opacity: 1;
		transform: none;
	}
	.theme.is-light .theme__moon {
		opacity: 0;
		transform: rotate(90deg) scale(0.4);
	}
</style>
