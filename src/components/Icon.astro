---
// Пиксельная иконка 8×8. Рисунок — строки из «#» (закрашено) и «.» (пусто).
// <Icon name="star" /> — цвет берётся из color родителя.
const ICONS = {
	star: ['...#....', '...#....', '..###...', '#######.', '.#####..', '..###...', '.##.##..', '.#...#..'],
	clock: ['..####..', '.#....#.', '#...#..#', '#...#..#', '#...###.', '#......#', '.#....#.', '..####..'],
	bulb: ['..###...', '.#...#..', '#.....#.', '#.....#.', '.#...#..', '..###...', '..###...', '...#....'],
	lock: ['..###...', '.#...#..', '.#...#..', '#######.', '#######.', '###.###.', '#######.', '#######.'],
	question: ['########', '#..##..#', '#.#..#.#', '#....#.#', '#...#..#', '#......#', '#...#..#', '########'],
	flag: ['#.......', '#####...', '#######.', '#####...', '#.......', '#.......', '#.......', '###.....'],
	castle: ['#.#.#.#.', '#######.', '.#####..', '.#####..', '.##.##..', '.#...#..', '.#...#..', '#######.'],
	arrow: ['..###...', '..###...', '..###...', '#######.', '.#####..', '..###...', '...#....', '........'],
	target: ['..###...', '.#...#..', '#..#..#.', '#.###.#.', '#..#..#.', '.#...#..', '..###...', '........'],
	run: ['...##...', '...##...', '.####...', '#.###.#.', '..##....', '.#..#...', '#....#..', '........'],
} as const;
export type IconName = keyof typeof ICONS;
interface Props {
	name: IconName;
	size?: number;
	class?: string;
}
const { name, size = 16, class: cls } = Astro.props;
const rects = ICONS[name].flatMap((row, y) => [...row].map((c, x) => (c === '#' ? [x, y] : null)).filter(Boolean)) as [number, number][];
---

<svg class:list={['px-icon', cls]} width={size} height={size} viewBox="0 0 8 8" aria-hidden="true" shape-rendering="crispEdges">
	{rects.map(([x, y]) => <rect x={x} y={y} width="1" height="1" fill="currentColor" />)}
</svg>

<style>
	.px-icon {
		display: inline-block;
		vertical-align: -0.15em;
		flex: none;
	}
</style>
